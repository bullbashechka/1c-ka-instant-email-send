// Проверка интерфейса мгновенной отправки через клиент тестирования 1С.
// Запускается из scripts/ui-check.sh в режиме менеджера тестирования:
// /TESTMANAGER /Execute <эта обработка> /C"<файл журнала>;<порт клиента тестирования>;<этап ok|down|quote|outbox>".
// Готовит черновики писем, открывает их в клиенте тестирования, нажимает «Отправить»
// и записывает в журнал окна и тексты, которые увидел бы пользователь, статусы писем и ошибки журнала регистрации.

&НаКлиенте
Перем Приложение, ФайлЖурнала, ПредыдущийСнимок;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Части = СтрРазделить(ПараметрЗапуска, ";");
	Если Части.Количество() < 3 Тогда
		Возврат;
	КонецЕсли;
	ФайлЖурнала = Части[0];
	ПредыдущийСнимок = "";

	НачалоПроверки = ТекущаяДатаСеансаНаСервере();
	Попытка
		Подключиться(Число(Части[1]));
		Если Части[2] = "ok" Тогда
			ЭтапСервисРаботает();
		ИначеЕсли Части[2] = "quote" Тогда
			ЭтапЦитата();
		ИначеЕсли Части[2] = "outbox" Тогда
			ЭтапИсходящие();
		Иначе
			ЭтапСервисНеРаботает();
		КонецЕсли;
	Исключение
		ВЖурнал("ОШИБКА СЦЕНАРИЯ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВЖурнал("Ошибки журнала регистрации с начала этапа:");
	Для Каждого Строка Из ОшибкиЖурналаРегистрации(НачалоПроверки) Цикл
		ВЖурнал("  " + Строка);
	КонецЦикла;
	ВЖурнал("КОНЕЦ");

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область Этапы

&НаКлиенте
Процедура ЭтапСервисРаботает()

	Письмо = СоздатьЧерновик("UI-проверка 1: обычное", "Тест с сохранением");
	Отправить(Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 1: " + СостояниеПисьма(Письмо));
	ПометитьНаУдаление(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письмо));

	Письмо = СоздатьЧерновик("", "Тест с сохранением");
	Отправить(Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 2 (без темы): " + СостояниеПисьма(Письмо));
	ПометитьНаУдаление(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письмо));

	Письмо = СоздатьЧерновик("UI-проверка 3: без сохранения", "Тест без сохранения");
	Отправить(Письмо, "Отправить");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 3 (без сохранения, ответ «Отправить»): " + СостояниеПисьма(Письмо));

КонецПроцедуры

&НаКлиенте
Процедура ЭтапСервисНеРаботает()

	Письма = Новый Массив;
	Письма.Добавить(СоздатьЧерновик("UI-проверка 4а: сервер недоступен", "Тест с сохранением"));
	Отправить(Письма[0], "");
	Письма.Добавить(СоздатьЧерновик("UI-проверка 4б: сервер недоступен", "Тест с сохранением"));
	Отправить(Письма[1], "");
	// П13: пока идут попытки, «Отправить сейчас» не запускает вторую отправку.
	ФормаПисьма = ОткрытьПисьмо(Письма[0]);
	НажатьОтправить(ФормаПисьма, Письма[0], "");
	ВЖурнал("Письмо 4а после «Отправить сейчас» во время попыток, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ЗакрытьЛишниеОкна();
	Письма.Добавить(СоздатьЧерновик("UI-проверка 5: истёк срок", "Тест с сохранением", 30));
	Отправить(Письма[2], "");

	Наблюдать(240, Письма);
	Для Каждого Письмо Из Письма Цикл
		ВЖурнал("Письмо " + СокрЛП(Письмо) + ": " + СостояниеПисьма(Письмо));
	КонецЦикла;
	ПометитьНаУдаление(Письма);

КонецПроцедуры

// Ответ с цитатой вернулся в черновики и отправлен повторно: цитата в письме одна.
// Сколько раз она пришла, скрипт считает по Mailpit (маркер UI-ЦИТАТА-6).
&НаКлиенте
Процедура ЭтапЦитата()

	Письма = Новый Массив;
	Письма.Добавить(СоздатьИсходноеПисьмо());
	Письмо = СоздатьЧерновик("UI-проверка 6: ответ", "Тест с сохранением", , "ui-check-reject@example.com", Письма[0]);
	Письма.Добавить(Письмо);

	Отправить(Письмо, "");
	Наблюдать(150, Письмо);
	ВЖурнал("Письмо 6 после отправки на непринятый адрес: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();
	Если ВернутьВЧерновикиЕслиИсходящее(Письмо) Тогда
		ВЖурнал("Mailpit отказал как при ошибке соединения: возврат в черновики выполнен вызовом ВернутьВЧерновики");
	КонецЕсли;

	СменитьАдресата(Письмо, "ui-check@test.local");
	Отправить(Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 6 после исправления адреса: " + СостояниеПисьма(Письмо));
	ПометитьНаУдаление(Письма);

КонецПроцедуры

// Письма из «Исходящих»: видимость «Отправить сейчас» и отправка из открытого письма (Ф4).
&НаКлиенте
Процедура ЭтапИсходящие()

	Письма = Новый Массив;

	// П6: отложенное письмо уходит по «Отправить сейчас» без правки, «Когда отправить» очищается.
	Письмо = СоздатьИсходящее("UI-проверка 7: отложенное", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ВЖурнал("Письмо 7 (отложенное), кнопки: " + СостояниеКнопок(ФормаПисьма));
	НажатьОтправить(ФормаПисьма, Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 7: " + СостояниеПисьма(Письмо));

	// П7: истёкший срок — кнопки нет.
	Письмо = СоздатьИсходящее("UI-проверка 8: срок истёк", 0, -60);
	Письма.Добавить(Письмо);
	ВЖурнал("Письмо 8 (срок истёк), кнопки: " + СостояниеКнопок(ОткрытьПисьмо(Письмо)));
	ЗакрытьЛишниеОкна();

	// П30: помеченное на удаление — кнопки нет.
	Письмо = СоздатьИсходящее("UI-проверка 9: помечено", 3600, 0, Истина);
	Письма.Добавить(Письмо);
	ВЖурнал("Письмо 9 (помечено на удаление), кнопки: " + СостояниеКнопок(ОткрытьПисьмо(Письмо)));
	ЗакрытьЛишниеОкна();

	// П24: смена «Не отправлять после» сразу меняет кнопки; изменённое письмо записывается и уходит.
	Письмо = СоздатьИсходящее("UI-проверка 10: смена срока", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ВЖурнал("Письмо 10, кнопки: " + СостояниеКнопок(ФормаПисьма));
	ВвестиНеОтправлятьПосле(ФормаПисьма, ТекущаяДатаСеансаНаСервере() - 3600);
	ВЖурнал("Письмо 10, срок в прошлом, кнопки: " + СостояниеКнопок(ФормаПисьма));
	ВвестиНеОтправлятьПосле(ФормаПисьма, ТекущаяДатаСеансаНаСервере() + 86400);
	ВЖурнал("Письмо 10, срок завтра, кнопки: " + СостояниеКнопок(ФормаПисьма));
	НажатьОтправить(ФормаПисьма, Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 10: " + СостояниеПисьма(Письмо));

	// П19: срок истёк при открытом окне — отказ с текстом, окно открыто, кнопки нет.
	Письмо = СоздатьИсходящее("UI-проверка 11: срок истекает", 0, 20);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ВЖурнал("Письмо 11, кнопки до срока: " + СостояниеКнопок(ФормаПисьма));
	Пауза(25);
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 11 после нажатия, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ВЖурнал("Письмо 11: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();

	// П32: письмо изменилось в базе, пока окно было открыто.
	Письмо = СоздатьИсходящее("UI-проверка 12: вернулось в черновики", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ВернутьВЧерновикиЕслиИсходящее(Письмо);
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 12 после нажатия, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ВЖурнал("Письмо 12: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();

	Письмо = СоздатьИсходящее("UI-проверка 13: помечено при открытом окне", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ПометитьНаУдаление(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письмо));
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 13 после нажатия, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ВЖурнал("Письмо 13: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();

	Письмо = СоздатьИсходящее("UI-проверка 14: удалено при открытом окне", 3600);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	УдалитьПисьмо(Письмо);
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 14 после нажатия: окно письма " + ?(НайтиФорму("СписокПолучателей") = Неопределено, "закрыто", "открыто"));
	ЗакрытьЛишниеОкна();

	// П34: письмо редактирует другой пользователь (его держит этот сеанс) — отказ с текстом, окно и кнопка
	// остаются, письмо не меняется. После освобождения письмо уходит.
	Письмо = СоздатьИсходящее("UI-проверка 15: письмо редактирует другой", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ЗанятьПисьмо(Письмо);
	ВЖурнал("Письмо занято сеансом менеджера тестирования");
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 15 после нажатия, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ВЖурнал("Письмо 15: " + СостояниеПисьма(Письмо));
	ОсвободитьПисьмо(Письмо);
	НажатьОтправить(ФормаПисьма, Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 15 после освобождения: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();

	// Ф4: письмо отправлено, пока окно было открыто, и его держит другой пользователь — без ошибки,
	// окно закрывается, фоновая отправка сообщает «Письмо отправлено» (всплывающее оповещение здесь не видно).
	Письмо = СоздатьИсходящее("UI-проверка 16: отправлено и занято", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ОтметитьОтправленным(Письмо);
	ЗанятьПисьмо(Письмо);
	ВЖурнал("Письмо занято сеансом менеджера тестирования");
	НажатьОтправить(ФормаПисьма, Письмо, "");
	Наблюдать(20);
	ВЖурнал("Письмо 16 после нажатия: окно письма " + ?(НайтиФорму("СписокПолучателей") = Неопределено, "закрыто", "открыто"));
	ВЖурнал("Письмо 16: " + СостояниеПисьма(Письмо));
	ОсвободитьПисьмо(Письмо);
	ЗакрытьЛишниеОкна();

	ПометитьНаУдаление(Письма);

КонецПроцедуры

#КонецОбласти

#Область ДействияВКлиентеТестирования

&НаКлиенте
Процедура Подключиться(Порт)

	Приложение = Новый ТестируемоеПриложение("localhost", Порт);
	Конец = ТекущаяДата() + 120;
	Пока Истина Цикл
		Попытка
			Приложение.УстановитьСоединение();
			Прервать;
		Исключение
			Если ТекущаяДата() > Конец Тогда
				ВызватьИсключение;
			КонецЕсли;
			Пауза(2);
		КонецПопытки;
	КонецЦикла;
	// Клиент тестирования должен закончить запуск. Окна, открытые при запуске (например, подключение
	// Интернет-поддержки), закрыть: модальное окно не даст открыть письмо.
	Пауза(10);
	ВЖурнал("Подключено к клиенту тестирования");
	Наблюдать(0);
	ЗакрытьЛишниеОкна();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьЛишниеОкна()

	Для Каждого ТестОкно Из Приложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если Не ТестОкно.Основное И ТестОкно.Заголовок <> "Начальная страница" Тогда
			ВЖурнал("Закрываю окно «" + ТестОкно.Заголовок + "»");
			ТестОкно.Закрыть();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Открывает письмо, нажимает «Отправить» и, если задан, отвечает на вопрос о сохранении.
&НаКлиенте
Процедура Отправить(Письмо, ОтветНаВопрос)

	НажатьОтправить(ОткрытьПисьмо(Письмо), Письмо, ОтветНаВопрос);

КонецПроцедуры

&НаКлиенте
Функция ОткрытьПисьмо(Письмо)

	ОсновноеОкно().ВыполнитьКоманду(НавигационнаяСсылка(Письмо));

	ФормаПисьма = Неопределено;
	Конец = ТекущаяДата() + 30;
	Пока ФормаПисьма = Неопределено И ТекущаяДата() < Конец Цикл
		Пауза(1);
		ФормаПисьма = НайтиФорму("СписокПолучателей");
	КонецЦикла;
	Если ФормаПисьма = Неопределено Тогда
		ВызватьИсключение "Форма письма не открылась";
	КонецЕсли;
	Возврат ФормаПисьма;

КонецФункции

&НаКлиенте
Процедура НажатьОтправить(ФормаПисьма, Письмо, ОтветНаВопрос)

	Кнопка = ФормаПисьма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "Отправить");
	ВЖурнал("Нажимаю «" + Кнопка.ТекстЗаголовка + "» в письме " + СокрЛП(Письмо));
	Кнопка.Нажать();

	Если ЗначениеЗаполнено(ОтветНаВопрос) Тогда
		Пауза(2);
		Наблюдать(0);
		Ответ = НайтиКнопкуВопроса(ОтветНаВопрос);
		Если Ответ = Неопределено Тогда
			ВызватьИсключение "Нет вопроса с кнопкой " + ОтветНаВопрос;
		КонецЕсли;
		ВЖурнал("Отвечаю «" + ОтветНаВопрос + "»");
		Ответ.Нажать();
	КонецЕсли;
	Пауза(2);
	Наблюдать(0);

КонецПроцедуры

// Видимость кнопок «Отправить»/«Отправить сейчас» и «Записать и закрыть» в форме письма.
&НаКлиенте
Функция СостояниеКнопок(ФормаПисьма)

	Если ФормаПисьма = Неопределено Тогда
		Возврат "окна письма нет";
	КонецЕсли;
	Отправить = ФормаПисьма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "Отправить");
	ЗаписатьИЗакрыть = ФормаПисьма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "ФормаЗаписатьИЗакрыть");
	Возврат СтрШаблон("«%1» %2, «Записать и закрыть» %3",
		?(Отправить = Неопределено, "Отправить", Отправить.ТекстЗаголовка), ВидимостьКнопки(Отправить),
		ВидимостьКнопки(ЗаписатьИЗакрыть));

КонецФункции

&НаКлиенте
Функция ВидимостьКнопки(Кнопка)

	Если Кнопка = Неопределено Тогда
		Возврат "скрыта";
	КонецЕсли;
	Возврат ?(Кнопка.ТекущаяВидимость(), "видна", "скрыта");

КонецФункции

// Вводит «Не отправлять после» и уходит в поле «Тема», чтобы сработал ПриИзменении.
&НаКлиенте
Процедура ВвестиНеОтправлятьПосле(ФормаПисьма, Дата)

	Поле = ФормаПисьма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "ДатаАктуальностиОтправки");
	Поле.Активизировать();
	Поле.ВвестиТекст(Формат(Дата, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'"));
	ФормаПисьма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Тема").Активизировать();
	Пауза(2);
	ВЖурнал("Ввёл «Не отправлять после» = " + Поле.ПолучитьОтображаемыйТекст());

КонецПроцедуры

// Записывает в журнал изменения окон клиента тестирования, опрашивая их каждые 2 секунды.
// Если переданы письма, ждёт, пока отправка всех закончится (не дольше Секунд), и ещё 20 секунд:
// клиент проверяет фоновое задание не реже раза в 15 секунд.
&НаКлиенте
Процедура Наблюдать(Секунд, Знач Письма = Неопределено)

	Конец = ТекущаяДата() + Секунд;
	Если Письма <> Неопределено Тогда
		Если ТипЗнч(Письма) <> Тип("Массив") Тогда
			Письма = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письма);
		КонецЕсли;
	КонецЕсли;
	Пока Истина Цикл
		Снимок = СнимокОкон();
		Если Снимок <> ПредыдущийСнимок Тогда
			ВЖурнал("Окна (" + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + "):" + Символы.ПС + Снимок);
			ПредыдущийСнимок = Снимок;
		КонецЕсли;
		Если Письма <> Неопределено И ОтправкаЗакончена(Письма) Тогда
			ВЖурнал("Отправка закончена: " + Формат(ТекущаяДата(), "ДФ=HH:mm:ss"));
			Письма = Неопределено;
			Конец = Мин(Конец, ТекущаяДата() + 20);
		КонецЕсли;
		Если ТекущаяДата() >= Конец Тогда
			Прервать;
		КонецЕсли;
		Пауза(2);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция СнимокОкон()

	Строки = Новый Массив;
	Для Каждого ТестОкно Из Приложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если ТестОкно.Основное Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить("  [окно] " + ТестОкно.Заголовок);
		Если ЭтоОкноПисьма(ТестОкно) Или ТестОкно.Заголовок = "Начальная страница" Тогда
			Продолжить;
		КонецЕсли;
		Тексты = Новый Массив;
		СобратьТексты(ТестОкно, Тексты, 0);
		Для Каждого Текст Из Тексты Цикл
			Строки.Добавить("      " + Текст);
		КонецЦикла;
	КонецЦикла;
	Попытка
		Для Каждого Текст Из Приложение.ПолучитьАктивноеОкно().ПолучитьТекстыСообщенийПользователю() Цикл
			Строки.Добавить("  [сообщение] " + Текст);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура СобратьТексты(Владелец, Тексты, Глубина)

	Если Глубина > 10 Или Тексты.Количество() > 40 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Подчиненные = Владелец.ПолучитьПодчиненныеОбъекты();
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого Элемент Из Подчиненные Цикл
		Текст = "";
		Попытка
			Текст = СокрЛП(Элемент.ТекстЗаголовка);
		Исключение
		КонецПопытки;
		Попытка
			Значение = СокрЛП(Элемент.ПолучитьОтображаемыйТекст());
			Если ЗначениеЗаполнено(Значение) Тогда
				Текст = Текст + " = " + Значение;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если ЗначениеЗаполнено(Текст) Тогда
			Тексты.Добавить(СтрЗаменить(Текст, Символы.ПС, " / "));
		КонецЕсли;
		СобратьТексты(Элемент, Тексты, Глубина + 1);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЭтоОкноПисьма(ТестОкно)

	Попытка
		Возврат ТестОкно.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "СписокПолучателей") <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ОсновноеОкно()

	Для Каждого ТестОкно Из Приложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если ТестОкно.Основное Тогда
			Возврат ТестОкно;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет основного окна клиента тестирования";

КонецФункции

// Форма активного окна, в которой есть элемент с указанным именем.
&НаКлиенте
Функция НайтиФорму(ИмяЭлемента)

	Попытка
		ТестОкно = Приложение.ПолучитьАктивноеОкно();
		Если ТестОкно.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , ИмяЭлемента) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ТестОкно.НайтиОбъект(Тип("ТестируемаяФорма"));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция НайтиКнопкуВопроса(ЗаголовокКнопки)

	Для Каждого ТестОкно Из Приложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если ТестОкно.Основное Или ЭтоОкноПисьма(ТестОкно) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Кнопка = ТестОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), ЗаголовокКнопки);
		Исключение
			Кнопка = Неопределено;
		КонецПопытки;
		Если Кнопка <> Неопределено Тогда
			Возврат Кнопка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура Пауза(Секунд)

	Конец = ТекущаяДата() + Секунд;
	Пока ТекущаяДата() < Конец Цикл
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВЖурнал(Текст)

	ДописатьВЖурнал(ФайлЖурнала, Текст);

КонецПроцедуры

#КонецОбласти

#Область Сервер

&НаСервереБезКонтекста
Процедура ДописатьВЖурнал(Файл, Текст)

	Запись = Новый ЗаписьТекста(Файл, КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку(Текст);
	Запись.Закрыть();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущаяДатаСеансаНаСервере()

	Возврат ТекущаяДатаСеанса();

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьЧерновик(Тема, ИмяУчетнойЗаписи, НеОтправлятьПослеСекунд = 0, Адрес = "ui-check@test.local",
	Основание = Неопределено)

	УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию(ИмяУчетнойЗаписи, Истина);
	Если УчетнаяЗапись.Пустая() Тогда
		ВызватьИсключение "Нет учётной записи " + ИмяУчетнойЗаписи;
	КонецЕсли;

	Письмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	Письмо.Дата = ТекущаяДатаСеанса();
	Письмо.Автор = Пользователи.ТекущийПользователь();
	Письмо.Ответственный = Письмо.Автор;
	Письмо.УчетнаяЗапись = УчетнаяЗапись;
	Письмо.ОтправительПредставление = СтрШаблон("%1 <%2>", УчетнаяЗапись.ИмяПользователя,
		УчетнаяЗапись.АдресЭлектроннойПочты);
	Письмо.Тема = Тема;
	Письмо.Текст = "Проверка интерфейса мгновенной отправки";
	Письмо.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст;
	Письмо.Кодировка = "UTF-8";
	Письмо.Важность = Перечисления.ВариантыВажностиВзаимодействия.Обычная;
	Письмо.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Черновик;
	Получатель = Письмо.ПолучателиПисьма.Добавить();
	Получатель.Адрес = Адрес;
	Получатель.Представление = Адрес;
	Письмо.СписокПолучателейПисьма = Адрес;
	Если НеОтправлятьПослеСекунд > 0 Тогда
		Письмо.ДатаАктуальностиОтправки = ТекущаяДатаСеанса() + НеОтправлятьПослеСекунд;
	КонецЕсли;
	Если Основание <> Неопределено Тогда
		Письмо.ВзаимодействиеОснование = Основание;
		Письмо.ВключатьТелоИсходногоПисьма = Истина;
	КонецЕсли;
	Письмо.Записать();
	Возврат Письмо.Ссылка;

КонецФункции

// Письмо в «Исходящих». Секунды отсчитываются от текущей даты; 0 — поле пустое.
&НаСервереБезКонтекста
Функция СоздатьИсходящее(Тема, КогдаОтправитьСекунд = 0, НеОтправлятьПослеСекунд = 0, Помечено = Ложь)

	Письмо = СоздатьЧерновик(Тема, "Тест с сохранением").ПолучитьОбъект();
	Письмо.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее;
	Если КогдаОтправитьСекунд <> 0 Тогда
		Письмо.ДатаКогдаОтправить = ТекущаяДатаСеанса() + КогдаОтправитьСекунд;
	КонецЕсли;
	Если НеОтправлятьПослеСекунд <> 0 Тогда
		Письмо.ДатаАктуальностиОтправки = ТекущаяДатаСеанса() + НеОтправлятьПослеСекунд;
	КонецЕсли;
	Письмо.Записать();
	Если Помечено Тогда
		Письмо.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
	Возврат Письмо.Ссылка;

КонецФункции

// Занимает письмо для редактирования, как форма другого пользователя с несохранённой правкой.
// Блокировка держится, пока открыта эта форма или до ОсвободитьПисьмо.
&НаСервере
Процедура ЗанятьПисьмо(Письмо)

	ЗаблокироватьДанныеДляРедактирования(Письмо, , УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура ОсвободитьПисьмо(Письмо)

	РазблокироватьДанныеДляРедактирования(Письмо, УникальныйИдентификатор);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтметитьОтправленным(Письмо)

	ПисьмоОбъект = Письмо.ПолучитьОбъект();
	ПисьмоОбъект.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Отправлено;
	ПисьмоОбъект.ДатаОтправления = ТекущаяДатаСеанса();
	ПисьмоОбъект.ДатаКогдаОтправить = Дата(1, 1, 1);
	ПисьмоОбъект.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьПисьмо(Письмо)

	Письмо.ПолучитьОбъект().Удалить();

КонецПроцедуры

// Исходное письмо для ответа с цитатой: уже «Отправлено», текст с маркером UI-ЦИТАТА-6.
&НаСервереБезКонтекста
Функция СоздатьИсходноеПисьмо()

	Письмо = СоздатьЧерновик("UI-проверка 6: исходное", "Тест с сохранением").ПолучитьОбъект();
	Письмо.Текст = "UI-ЦИТАТА-6: текст исходного письма";
	Письмо.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Отправлено;
	Письмо.ДатаОтправления = ТекущаяДатаСеанса();
	Письмо.Записать();
	Возврат Письмо.Ссылка;

КонецФункции

// Если Mailpit отказал адресату как при ошибке соединения, письмо осталось «Исходящим».
// Тогда возврат в черновики выполняет тот же код, что и при «сервер не принял адресатов».
&НаСервереБезКонтекста
Функция ВернутьВЧерновикиЕслиИсходящее(Письмо)

	Если Письмо.СтатусПисьма <> Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее Тогда
		Возврат Ложь;
	КонецЕсли;
	// Модуль расширения: при сборке обработки проверка исходников его не видит.
	ОбщегоНазначения.ОбщийМодуль("моп_МгновеннаяОтправкаПисем").ВернутьВЧерновики(Письмо);
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Процедура СменитьАдресата(Письмо, Адрес)

	ПисьмоОбъект = Письмо.ПолучитьОбъект();
	ПисьмоОбъект.ПолучателиПисьма.Очистить();
	Получатель = ПисьмоОбъект.ПолучателиПисьма.Добавить();
	Получатель.Адрес = Адрес;
	Получатель.Представление = Адрес;
	ПисьмоОбъект.СписокПолучателейПисьма = Адрес;
	ПисьмоОбъект.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Функция НавигационнаяСсылка(Письмо)

	Возврат ПолучитьНавигационнуюСсылку(Письмо);

КонецФункции

&НаСервереБезКонтекста
Функция СостояниеПисьма(Письмо)

	Если Не ОбщегоНазначения.СсылкаСуществует(Письмо) Тогда
		Возврат "удалено из базы";
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Письмо,
		"СтатусПисьма, ДатаКогдаОтправить, ДатаОтправления, ПометкаУдаления");
	Возврат СтрШаблон("статус %1, когда отправить «%2», дата отправления «%3»%4", Реквизиты.СтатусПисьма,
		Реквизиты.ДатаКогдаОтправить, Реквизиты.ДатаОтправления, ?(Реквизиты.ПометкаУдаления, ", помечено на удаление", ""));

КонецФункции

// Отправка закончена, когда у письма нет служебного «Когда отправить» или его нет в базе.
&НаСервереБезКонтекста
Функция ОтправкаЗакончена(Письма)

	Для Каждого Письмо Из Письма Цикл
		Если ОбщегоНазначения.СсылкаСуществует(Письмо)
			И ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Письмо, "ДатаКогдаОтправить")) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Процедура ПометитьНаУдаление(Письма)

	Для Каждого Письмо Из Письма Цикл
		Если ОбщегоНазначения.СсылкаСуществует(Письмо) Тогда
			Письмо.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОшибкиЖурналаРегистрации(Начало)

	Таблица = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Таблица, Новый Структура("ДатаНачала, Уровень", Начало, УровеньЖурналаРегистрации.Ошибка));
	Строки = Новый Массив;
	Для Каждого Запись Из Таблица Цикл
		Строки.Добавить(СтрШаблон("%1 %2 | %3 | %4", Формат(Запись.Дата, "ДФ=HH:mm:ss"), Запись.Событие,
			Запись.ПредставлениеДанных, Лев(СтрЗаменить(Запись.Комментарий, Символы.ПС, " / "), 600)));
	КонецЦикла;
	Возврат Строки;

КонецФункции

#КонецОбласти
