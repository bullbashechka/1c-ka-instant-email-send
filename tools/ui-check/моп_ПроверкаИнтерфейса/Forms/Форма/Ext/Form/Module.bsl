&НаКлиенте
Функция НайтиКнопкуВОкне(ТестОкно, ЗаголовокКнопки)

	Попытка
		Возврат ТестОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), ЗаголовокКнопки);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Заголовки и типы элементов окна, чтобы понять, чего не хватает сценарию.
&НаКлиенте
Функция ЭлементыОкна(ТестОкно)

	Тексты = Новый Массив;
	СобратьТексты(ТестОкно, Тексты, 0);
	Возврат "      " + СтрСоединить(Тексты, Символы.ПС + "      ");

КонецФункции

// Включает или выключает опцию «Штрихкодирование печатных форм объектов»; возвращает прежнее значение.
&НаСервереБезКонтекста
Функция УстановитьШтрихкодПечатныхФорм(Значение)

	Предыдущее = Константы.ИспользоватьШтрихкодированиеПечатныхФормОбъектов.Получить();
	Если Предыдущее <> Значение Тогда
		Константы.ИспользоватьШтрихкодированиеПечатныхФормОбъектов.Установить(Значение);
	КонецЕсли;
	Возврат Предыдущее;

КонецФункции

// Исходящие письма с точной темой, не помеченные на удаление.
&НаСервереБезКонтекста
Функция ПисьмаСТемой(Тема)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Письма.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭлектронноеПисьмоИсходящее КАК Письма
	|ГДЕ
	|	Письма.Тема = &Тема
	|	И НЕ Письма.ПометкаУдаления";
	Запрос.УстановитьПараметр("Тема", Тема);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Последний проведённый счёт на оплату клиенту и тема, которую для него ожидает Ф10.
&НаСервереБезКонтекста
Функция НайтиСчет()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Счета.Ссылка КАК Ссылка,
	|	Счета.Номер КАК Номер,
	|	Счета.Дата КАК Дата
	|ИЗ
	|	Документ.СчетНаОплатуКлиенту КАК Счета
	|ГДЕ
	|	Счета.Проведен
	|	И НЕ Счета.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счета.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Выборка.Ссылка);
	Результат.Вставить("Представление", Строка(Выборка.Ссылка));
	Результат.Вставить("ОжидаемаяТема", "Счет на оплату № " + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер)
		+ " от " + Формат(Выборка.Дата, "ДЛФ=D"));
	Возврат Результат;

КонецФункции

// Последний проведённый заказ клиента с товарами и этапами оплаты (по нему форма счёта печатается) и тема, которую ожидает Ф10.
&НаСервереБезКонтекста
Функция НайтиЗаказ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказы.Ссылка КАК Ссылка,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата
	|ИЗ
	|	Документ.ЗаказКлиента КАК Заказы
	|ГДЕ
	|	Заказы.Проведен
	|	И НЕ Заказы.ПометкаУдаления
	|	И Заказы.Ссылка В
	|		(ВЫБРАТЬ Товары.Ссылка ИЗ Документ.ЗаказКлиента.Товары КАК Товары)
	|	И Заказы.Ссылка В
	|		(ВЫБРАТЬ Этапы.Ссылка ИЗ Документ.ЗаказКлиента.ЭтапыГрафикаОплаты КАК Этапы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказы.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Выборка.Ссылка);
	Результат.Вставить("Представление", Строка(Выборка.Ссылка));
	Результат.Вставить("ОжидаемаяТема", "Счет на оплату № " + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер)
		+ " от " + Формат(Выборка.Дата, "ДЛФ=D"));
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СостояниеПисьма(Письмо)

	Если Не ОбщегоНазначения.СсылкаСуществует(Письмо) Тогда
		Возврат "удалено из базы";
	КонецЕсли;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Письмо,
		"СтатусПисьма, ДатаКогдаОтправить, ДатаОтправления, ПометкаУдаления");
	Возврат СтрШаблон("статус %1, когда отправить «%2», дата отправления «%3»%4", Реквизиты.СтатусПисьма,
		Реквизиты.ДатаКогдаОтправить, Реквизиты.ДатаОтправления, ?(Реквизиты.ПометкаУдаления, ", помечено на удаление", ""));

КонецФункции

// Отправка закончена, когда у письма нет служебного «Когда отправить» или его нет в базе.
&НаСервереБезКонтекста
Функция ОтправкаЗакончена(Письма)

	Для Каждого Письмо Из Письма Цикл
		Если ОбщегоНазначения.СсылкаСуществует(Письмо)
			И ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Письмо, "ДатаКогдаОтправить")) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Процедура ПометитьНаУдаление(Письма)

	Для Каждого Письмо Из Письма Цикл
		Если ОбщегоНазначения.СсылкаСуществует(Письмо) Тогда
			Письмо.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОшибкиЖурналаРегистрации(Начало)

	Таблица = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Таблица, Новый Структура("ДатаНачала, Уровень", Начало, УровеньЖурналаРегистрации.Ошибка));
	Строки = Новый Массив;
	Для Каждого Запись Из Таблица Цикл
		Строки.Добавить(СтрШаблон("%1 %2 | %3 | %4", Формат(Запись.Дата, "ДФ=HH:mm:ss"), Запись.Событие,
			Запись.ПредставлениеДанных, Лев(СтрЗаменить(Запись.Комментарий, Символы.ПС, " / "), 600)));
	КонецЦикла;
	Возврат Строки;

КонецФункции

#КонецОбласти
