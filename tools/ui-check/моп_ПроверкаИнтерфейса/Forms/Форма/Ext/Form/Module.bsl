	МенеджерЗаписи.Прочитать();
	Возврат ?(МенеджерЗаписи.Выбран(), "запись регистра блокировки есть, " + Формат(МенеджерЗаписи.ДатаБлокировки, "ДФ=HH:mm:ss"),
