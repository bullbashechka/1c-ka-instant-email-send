// Проверка интерфейса мгновенной отправки через клиент тестирования 1С.
// Запускается из scripts/ui-check.sh в режиме менеджера тестирования:
// /TESTMANAGER /Execute <эта обработка> /C"<файл журнала>;<порт клиента тестирования>;<этап>".
// Этапы ok, down, quote, outbox, hold, invoice, order проверяют рабочую базу разработки; open, copy, unlock — копию базы при проверке установки.
// Готовит черновики писем, открывает их в клиенте тестирования, нажимает «Отправить»
// и записывает в журнал окна и тексты, которые увидел бы пользователь, статусы писем и ошибки журнала регистрации.

&НаКлиенте
Перем Приложение, ФайлЖурнала, ПредыдущийСнимок;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Части = СтрРазделить(ПараметрЗапуска, ";");
	Если Части.Количество() < 3 Тогда
		Возврат;
	КонецЕсли;
	ФайлЖурнала = Части[0];
	ПредыдущийСнимок = "";

	НачалоПроверки = ТекущаяДатаСеансаНаСервере();
	Попытка
		Подключиться(Число(Части[1]));
		Если Части[2] = "ok" Тогда
			ЭтапСервисРаботает();
		ИначеЕсли Части[2] = "quote" Тогда
			ЭтапЦитата();
		ИначеЕсли Части[2] = "outbox" Тогда
			ЭтапИсходящие();
		ИначеЕсли Части[2] = "hold" Тогда
			ЭтапПисьмоЗанято();
		ИначеЕсли Части[2] = "open" Тогда
			ЭтапНовоеПисьмо();
		ИначеЕсли Части[2] = "copy" Тогда
			ЭтапКопияБазы();
		ИначеЕсли Части[2] = "unlock" Тогда
			ЭтапРазблокировка();
		ИначеЕсли Части[2] = "invoice" Тогда
			ЭтапСчет();
		ИначеЕсли Части[2] = "order" Тогда
			ЭтапЗаказ();
		Иначе
			ЭтапСервисНеРаботает();
		КонецЕсли;
	Исключение
		ВЖурнал("ОШИБКА СЦЕНАРИЯ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВЖурнал("Ошибки журнала регистрации с начала этапа:");
	Для Каждого Строка Из ОшибкиЖурналаРегистрации(НачалоПроверки) Цикл
		ВЖурнал("  " + Строка);
	КонецЦикла;
	ВЖурнал("КОНЕЦ");

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область Этапы

&НаКлиенте
Процедура ЭтапСервисРаботает()

	Письмо = СоздатьЧерновик("UI-проверка 1: обычное", "Тест с сохранением");
	Отправить(Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 1: " + СостояниеПисьма(Письмо));
	ПометитьНаУдаление(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письмо));

	Письмо = СоздатьЧерновик("", "Тест с сохранением");
	Отправить(Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 2 (без темы): " + СостояниеПисьма(Письмо));
	ПометитьНаУдаление(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письмо));

	Письмо = СоздатьЧерновик("UI-проверка 3: без сохранения", "Тест без сохранения");
	Отправить(Письмо, "Отправить");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 3 (без сохранения, ответ «Отправить»): " + СостояниеПисьма(Письмо));

КонецПроцедуры

&НаКлиенте
Процедура ЭтапСервисНеРаботает()

	Письма = Новый Массив;
	Письма.Добавить(СоздатьЧерновик("UI-проверка 4а: сервер недоступен", "Тест с сохранением"));
	Отправить(Письма[0], "");
	Письма.Добавить(СоздатьЧерновик("UI-проверка 4б: сервер недоступен", "Тест с сохранением"));
	Отправить(Письма[1], "");
	// П13: пока идут попытки, «Отправить сейчас» не запускает вторую отправку.
	ФормаПисьма = ОткрытьПисьмо(Письма[0]);
	НажатьОтправить(ФормаПисьма, Письма[0], "");
	ВЖурнал("Письмо 4а после «Отправить сейчас» во время попыток, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ЗакрытьЛишниеОкна();
	Письма.Добавить(СоздатьЧерновик("UI-проверка 5: истёк срок", "Тест с сохранением", 30));
	Отправить(Письма[2], "");

	Наблюдать(240, Письма);
	Для Каждого Письмо Из Письма Цикл
		ВЖурнал("Письмо " + СокрЛП(Письмо) + ": " + СостояниеПисьма(Письмо));
	КонецЦикла;
	ПометитьНаУдаление(Письма);

КонецПроцедуры

// Ответ с цитатой вернулся в черновики и отправлен повторно: цитата в письме одна.
// Сколько раз она пришла, скрипт считает по Mailpit (маркер UI-ЦИТАТА-6).
&НаКлиенте
Процедура ЭтапЦитата()

	Письма = Новый Массив;
	Письма.Добавить(СоздатьИсходноеПисьмо());
	Письмо = СоздатьЧерновик("UI-проверка 6: ответ", "Тест с сохранением", , "ui-check-reject@example.com", Письма[0]);
	Письма.Добавить(Письмо);

	Отправить(Письмо, "");
	Наблюдать(150, Письмо);
	ВЖурнал("Письмо 6 после отправки на непринятый адрес: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();
	Если ВернутьВЧерновикиЕслиИсходящее(Письмо) Тогда
		ВЖурнал("Mailpit отказал как при ошибке соединения: возврат в черновики выполнен вызовом ВернутьВЧерновики");
	КонецЕсли;

	СменитьАдресата(Письмо, "ui-check@test.local");
	Отправить(Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 6 после исправления адреса: " + СостояниеПисьма(Письмо));
	ПометитьНаУдаление(Письма);

КонецПроцедуры

// Ф10: «Печать → Счет на оплату → Отправить» из счёта на оплату открывает письмо с темой «Счет на оплату № … от …»,
// письмо уходит в Mailpit с этой темой. На Mac внешняя компонента штрихкода не подключается, и печатная форма счёта падает,
// поэтому на время этапа выключается опция «Штрихкодирование печатных форм объектов» и затем возвращается.
&НаКлиенте
Процедура ЭтапСчет()

	Счет = НайтиСчет();
	Если Счет = Неопределено Тогда
		ВЖурнал("В базе нет проведённого счёта на оплату клиенту");
		Возврат;
	КонецЕсли;
	ВЖурнал("Счёт: " + Счет.Представление + "; ожидаемая тема: «" + Счет.ОжидаемаяТема + "»");

	ШтрихкодБылВключён = УстановитьШтрихкодПечатныхФорм(Ложь);
	ВЖурнал("Опция «Штрихкодирование печатных форм объектов» была " + ?(ШтрихкодБылВключён, "включена, выключена на время этапа",
		"выключена"));
	Попытка
		ПровестиОтправкуСчета(Счет);
	Исключение
		ВЖурнал("ОШИБКА ЭТАПА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если ШтрихкодБылВключён Тогда
		УстановитьШтрихкодПечатныхФорм(Истина);
		ВЖурнал("Опция «Штрихкодирование печатных форм объектов» возвращена: включена");
	КонецЕсли;

КонецПроцедуры

// Ф10: то же для печати из заказа клиента. Форма ГЕМ уходит в Mailpit, типовой «Счет на оплату» проверяется по теме письма
// без отправки, а печатная форма «Заказ клиента» не должна получить тему счёта.
&НаКлиенте
Процедура ЭтапЗаказ()

	Заказ = НайтиЗаказ();
	Если Заказ = Неопределено Тогда
		ВЖурнал("В базе нет проведённого заказа клиента с товарами и этапами оплаты");
		Возврат;
	КонецЕсли;
	ВЖурнал("Заказ: " + Заказ.Представление + "; ожидаемая тема: «" + Заказ.ОжидаемаяТема + "»");

	ШтрихкодБылВключён = УстановитьШтрихкодПечатныхФорм(Ложь);
	ВЖурнал("Опция «Штрихкодирование печатных форм объектов» была " + ?(ШтрихкодБылВключён, "включена, выключена на время этапа",
		"выключена"));
	Попытка
		ВЖурнал("--- Форма ГЕМ: отправка");
		ПровестиОтправкуСчета(Заказ, "ГЕМ: Счет на оплату общая", Истина);
		ВЖурнал("--- Типовой «Счет на оплату» из заказа: только тема");
		ПровестиОтправкуСчета(Заказ, "Счет на оплату", Ложь);
		ВЖурнал("--- Печатная форма «Заказ клиента»: тема не должна быть темой счёта");
		Заказ.ОжидаемаяТема = Неопределено;
		ПровестиОтправкуСчета(Заказ, "Заказ клиента", Ложь);
	Исключение
		ВЖурнал("ОШИБКА ЭТАПА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если ШтрихкодБылВключён Тогда
		УстановитьШтрихкодПечатныхФорм(Истина);
		ВЖурнал("Опция «Штрихкодирование печатных форм объектов» возвращена: включена");
	КонецЕсли;

КонецПроцедуры

// Открывает документ, печатает форму по команде «Печать → <КомандаПечати>», нажимает «Отправить...» и проверяет тему письма.
// ОжидаемаяТема = Неопределено: тема не должна начинаться с «Счет на оплату №».
// Отправлять = Ложь: письмо закрывается без отправки.
&НаКлиенте
Процедура ПровестиОтправкуСчета(Счет, КомандаПечати = "Счет на оплату", Отправлять = Истина)

	ОсновноеОкно().ВыполнитьКоманду(НавигационнаяСсылка(Счет.Ссылка));
	Пауза(5);
	Наблюдать(0);
	ОкноСчета = Приложение.ПолучитьАктивноеОкно();
	ВЖурнал("Окно документа: " + ОкноСчета.Заголовок);

	КнопкаПечати = НайтиКнопкуВОкне(ОкноСчета, КомандаПечати);
	Если КнопкаПечати = Неопределено Тогда
		ВЖурнал("Нет команды «" + КомандаПечати + "». Элементы окна:" + Символы.ПС + ЭлементыОкна(ОкноСчета));
		ЗакрытьЛишниеОкна();
		Возврат;
	КонецЕсли;
	ВЖурнал("Нажимаю «Печать → " + КомандаПечати + "»");
	КнопкаПечати.Нажать();
	Пауза(10);
	Наблюдать(0);

	ОкноПечати = Приложение.ПолучитьАктивноеОкно();
	ВЖурнал("Окно печати: " + ОкноПечати.Заголовок);
	КнопкаОтправить = НайтиКнопкуВОкне(ОкноПечати, "Отправить...");
	Если КнопкаОтправить = Неопределено Тогда
		ВЖурнал("Нет кнопки «Отправить...» в окне печати. Элементы окна:" + Символы.ПС + ЭлементыОкна(ОкноПечати));
		ЗакрытьЛишниеОкна();
		Возврат;
	КонецЕсли;
	ВЖурнал("Нажимаю «Отправить...»");
	КнопкаОтправить.Нажать();
	Пауза(5);
	Наблюдать(0);

	// Окно выбора формата вложения: PDF уже выбран по умолчанию.
	Для Номер = 1 По 3 Цикл
		ФормаПисьма = НайтиФорму("СписокПолучателей");
		Если ФормаПисьма <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		Кнопка = НайтиКнопкуВопроса("Выбрать");
		Если Кнопка = Неопределено Тогда
			ВЖурнал("Окно выбора формата не найдено. Окна:" + Символы.ПС + СнимокОкон());
			Прервать;
		КонецЕсли;
		ВЖурнал("Окно выбора формата: нажимаю «" + Кнопка.ТекстЗаголовка + "»");
		Кнопка.Нажать();
		Пауза(5);
		Наблюдать(0);
	КонецЦикла;

	ФормаПисьма = НайтиФорму("СписокПолучателей");
	Если ФормаПисьма = Неопределено Тогда
		ВЖурнал("Окно письма не открылось. Окна:" + Символы.ПС + СнимокОкон());
		ЗакрытьЛишниеОкна();
		Возврат;
	КонецЕсли;
	Тема = ФормаПисьма.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "Тема").ПолучитьОтображаемыйТекст();
	Если Счет.ОжидаемаяТема = Неопределено Тогда
		ВЖурнал("Тема в открывшемся письме: «" + Тема + "»" + ?(СтрНачинаетсяС(Тема, "Счет на оплату №"),
			" — НЕВЕРНО, это тема счёта", " — не тема счёта, как и ожидалось"));
	Иначе
		ВЖурнал("Тема в открывшемся письме: «" + Тема + "»" + ?(Тема = Счет.ОжидаемаяТема, " — совпала с ожидаемой",
			" — НЕ СОВПАЛА, ожидалась «" + Счет.ОжидаемаяТема + "»"));
	КонецЕсли;

	Если Не Отправлять Тогда
		ЗакрытьПисьмоБезОтправки();
		Возврат;
	КонецЕсли;

	// Получатель у контрагента счёта в демо-базе не указан: вписываем адрес Mailpit и отправляем.
	Таблица = ФормаПисьма.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "СписокПолучателей");
	Таблица.ДобавитьСтроку();
	Поле = Таблица.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , "СписокПолучателейПредставление");
	Если Поле = Неопределено Тогда
		ВЖурнал("Поле получателя не найдено. Элементы окна:" + Символы.ПС + ЭлементыОкна(Приложение.ПолучитьАктивноеОкно()));
		ЗакрытьЛишниеОкна();
		Возврат;
	КонецЕсли;
	Поле.ВвестиТекст("ui-check@test.local");
	ВЖурнал("Получатель: " + Поле.ПолучитьОтображаемыйТекст());
	Таблица.ЗакончитьРедактированиеСтроки();
	Пауза(2);

	Кнопка = ФормаПисьма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "Отправить");
	ВЖурнал("Нажимаю «" + Кнопка.ТекстЗаголовка + "» в письме");
	Кнопка.Нажать();
	Пауза(3);
	Наблюдать(0);
	Ответ = НайтиКнопкуВопроса("Отправить");
	Если Ответ <> Неопределено Тогда
		ВЖурнал("Вопрос о сохранении: отвечаю «Отправить»");
		Ответ.Нажать();
	КонецЕсли;
	Наблюдать(45);
	Письма = ПисьмаСТемой(Счет.ОжидаемаяТема);
	Для Каждого Письмо Из Письма Цикл
		ВЖурнал("Письмо со счётом после отправки: " + СостояниеПисьма(Письмо));
	КонецЦикла;
	Если Письма.Количество() = 0 Тогда
		ВЖурнал("Письмо с темой «" + Счет.ОжидаемаяТема + "» в базе не найдено");
	КонецЕсли;
	ПометитьНаУдаление(Письма);
	ЗакрытьЛишниеОкна();

КонецПроцедуры

// Письма из «Исходящих»: видимость «Отправить сейчас» и отправка из открытого письма (Ф4).
&НаКлиенте
Процедура ЭтапИсходящие()

	Письма = Новый Массив;

	// П6: отложенное письмо уходит по «Отправить сейчас» без правки, «Когда отправить» очищается.
	Письмо = СоздатьИсходящее("UI-проверка 7: отложенное", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ВЖурнал("Письмо 7 (отложенное), кнопки: " + СостояниеКнопок(ФормаПисьма));
	НажатьОтправить(ФормаПисьма, Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 7: " + СостояниеПисьма(Письмо));

	// П7: истёкший срок — кнопки нет.
	Письмо = СоздатьИсходящее("UI-проверка 8: срок истёк", 0, -60);
	Письма.Добавить(Письмо);
	ВЖурнал("Письмо 8 (срок истёк), кнопки: " + СостояниеКнопок(ОткрытьПисьмо(Письмо)));
	ЗакрытьЛишниеОкна();

	// П30: помеченное на удаление — кнопки нет.
	Письмо = СоздатьИсходящее("UI-проверка 9: помечено", 3600, 0, Истина);
	Письма.Добавить(Письмо);
	ВЖурнал("Письмо 9 (помечено на удаление), кнопки: " + СостояниеКнопок(ОткрытьПисьмо(Письмо)));
	ЗакрытьЛишниеОкна();

	// П24: смена «Не отправлять после» сразу меняет кнопки; изменённое письмо записывается и уходит.
	Письмо = СоздатьИсходящее("UI-проверка 10: смена срока", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ВЖурнал("Письмо 10, кнопки: " + СостояниеКнопок(ФормаПисьма));
	ВвестиНеОтправлятьПосле(ФормаПисьма, ТекущаяДатаСеансаНаСервере() - 3600);
	ВЖурнал("Письмо 10, срок в прошлом, кнопки: " + СостояниеКнопок(ФормаПисьма));
	ВвестиНеОтправлятьПосле(ФормаПисьма, ТекущаяДатаСеансаНаСервере() + 86400);
	ВЖурнал("Письмо 10, срок завтра, кнопки: " + СостояниеКнопок(ФормаПисьма));
	НажатьОтправить(ФормаПисьма, Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 10: " + СостояниеПисьма(Письмо));

	// П19: срок истёк при открытом окне — отказ с текстом, окно открыто, кнопки нет.
	Письмо = СоздатьИсходящее("UI-проверка 11: срок истекает", 0, 20);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ВЖурнал("Письмо 11, кнопки до срока: " + СостояниеКнопок(ФормаПисьма));
	Пауза(25);
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 11 после нажатия, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ВЖурнал("Письмо 11: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();

	// П32: письмо изменилось в базе, пока окно было открыто.
	Письмо = СоздатьИсходящее("UI-проверка 12: вернулось в черновики", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ВернутьВЧерновикиЕслиИсходящее(Письмо);
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 12 после нажатия, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ВЖурнал("Письмо 12: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();

	Письмо = СоздатьИсходящее("UI-проверка 13: помечено при открытом окне", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ПометитьНаУдаление(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письмо));
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 13 после нажатия, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ВЖурнал("Письмо 13: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();

	Письмо = СоздатьИсходящее("UI-проверка 14: удалено при открытом окне", 3600);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	УдалитьПисьмо(Письмо);
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 14 после нажатия: окно письма " + ?(НайтиФорму("СписокПолучателей") = Неопределено, "закрыто", "открыто"));
	ЗакрытьЛишниеОкна();

	// П34: письмо редактирует другой пользователь (его держит этот сеанс) — отказ с текстом, окно и кнопка
	// остаются, письмо не меняется. После освобождения письмо уходит.
	Письмо = СоздатьИсходящее("UI-проверка 15: письмо редактирует другой", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ЗанятьПисьмо(Письмо);
	ВЖурнал("Письмо занято сеансом менеджера тестирования");
	НажатьОтправить(ФормаПисьма, Письмо, "");
	ВЖурнал("Письмо 15 после нажатия, кнопки: " + СостояниеКнопок(НайтиФорму("СписокПолучателей")));
	ВЖурнал("Письмо 15: " + СостояниеПисьма(Письмо));
	ОсвободитьПисьмо(Письмо);
	НажатьОтправить(ФормаПисьма, Письмо, "");
	Наблюдать(120, Письмо);
	ВЖурнал("Письмо 15 после освобождения: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();

	// Ф4: письмо отправлено, пока окно было открыто, и его держит другой пользователь — без ошибки,
	// окно закрывается, фоновая отправка сообщает «Письмо отправлено» (всплывающее оповещение здесь не видно).
	Письмо = СоздатьИсходящее("UI-проверка 16: отправлено и занято", 3600);
	Письма.Добавить(Письмо);
	ФормаПисьма = ОткрытьПисьмо(Письмо);
	ОтметитьОтправленным(Письмо);
	ЗанятьПисьмо(Письмо);
	ВЖурнал("Письмо занято сеансом менеджера тестирования");
	НажатьОтправить(ФормаПисьма, Письмо, "");
	Наблюдать(20);
	ВЖурнал("Письмо 16 после нажатия: окно письма " + ?(НайтиФорму("СписокПолучателей") = Неопределено, "закрыто", "открыто"));
	ВЖурнал("Письмо 16: " + СостояниеПисьма(Письмо));
	ОсвободитьПисьмо(Письмо);
	ЗакрытьЛишниеОкна();

	ПометитьНаУдаление(Письма);

КонецПроцедуры

// Письмо занято правкой в другом сеансе, пока его отправляют (Ф2, Ф7). Черновик уже скрыт той записью, которая
// перевела его в «Исходящие»; учётная запись занята, пока не записан результат; правка дольше 2 минут
// не меняет итог «Письмо отправлено». Чтобы занять письмо до записи результата, учётную запись сначала держит
// запись регистра этого сеанса: в файловой базе она действует всегда, и фоновая отправка ждёт.
&НаКлиенте
Процедура ЭтапПисьмоЗанято()

	ИмяУчетнойЗаписи = "Тест с сохранением";
	Письма = Новый Массив;
	Письмо = Неопределено;
	Попытка
		Письмо = СоздатьЧерновик("UI-проверка 17: письмо занято", ИмяУчетнойЗаписи);
		Письма.Добавить(Письмо);
		ОтправитьЗанятоеПисьмо(Письмо, "17", ИмяУчетнойЗаписи, 12);
		ОсвободитьПисьмо(Письмо);
		Наблюдать(60, Письмо);
		ВЖурнал("Письмо 17 после освобождения: " + СостояниеПисьма(Письмо) + "; "
			+ ЗаписьБлокировкиУчетнойЗаписи(ИмяУчетнойЗаписи)
			+ " (ожидается: статус Отправлено, «Когда отправить» пустое, записи регистра нет)");

		Письмо = СоздатьЧерновик("UI-проверка 18: правка дольше 2 минут", ИмяУчетнойЗаписи);
		Письма.Добавить(Письмо);
		ОтправитьЗанятоеПисьмо(Письмо, "18", ИмяУчетнойЗаписи, 150);
		ВЖурнал("Письмо 18 через 150 с: " + СостояниеПисьма(Письмо) + "; " + ЗаписьБлокировкиУчетнойЗаписи(ИмяУчетнойЗаписи)
			+ " (ожидается: статус Исходящее со служебным «Когда отправить», записи регистра нет, окна «Письмо не отправлено»"
			+ " нет; в журнале регистрации ошибка «Мгновенная отправка, попытка 1»)");
		ОсвободитьПисьмо(Письмо);
	Исключение
		Если Письмо <> Неопределено Тогда
			ОсвободитьПисьмо(Письмо);
		КонецЕсли;
		СнятьБлокировкуУчетнойЗаписи(ИмяУчетнойЗаписи);
		ПометитьНаУдаление(Письма);
		ВызватьИсключение;
	КонецПопытки;
	СнятьБлокировкуУчетнойЗаписи(ИмяУчетнойЗаписи);
	ЗакрытьЛишниеОкна();
	ПометитьНаУдаление(Письма);

КонецПроцедуры

// «Отправить» черновика при занятой учётной записи; пока отправка ждёт, письмо занимает этот сеанс,
// затем учётная запись освобождается, и письмо уходит, а запись результата ждёт письмо.
&НаКлиенте
Процедура ОтправитьЗанятоеПисьмо(Письмо, Номер, ИмяУчетнойЗаписи, СекундДержать)

	ЗанятьУчетнуюЗапись(ИмяУчетнойЗаписи);
	Отправить(Письмо, "");
	ВЖурнал(СтрШаблон("Письмо %1, учётная запись занята: %2; служебное время через %3 с"
		+ " (ожидается: статус Исходящее, около 600 с — черновик скрыт той же записью)",
		Номер, СостояниеПисьма(Письмо), СекундДоКогдаОтправить(Письмо)));
	ЗанятьПисьмо(Письмо);
	СнятьБлокировкуУчетнойЗаписи(ИмяУчетнойЗаписи);
	ВЖурнал("Письмо занято сеансом менеджера тестирования, учётная запись освобождена");
	// В файловой базе фоновое задание может начаться не сразу: ждём, пока отправка займёт учётную запись.
	Начало = ТекущаяДата();
	Пока СтрНачинаетсяС(ЗаписьБлокировкиУчетнойЗаписи(ИмяУчетнойЗаписи), "записи")
		И ТекущаяДата() < Начало + 60 Цикл
		Наблюдать(2);
	КонецЦикла;
	// Письмо в Mailpit уходит за секунды, запись результата ждёт письмо.
	Наблюдать(5);
	Прошло = ТекущаяДата() - Начало;
	ВЖурнал(СтрШаблон("Письмо %1 через %2 с: %3; %4 (ожидается: статус Исходящее, запись регистра есть — письмо ушло,"
		+ " отправка держит учётную запись до записи результата)",
		Номер, Прошло, СостояниеПисьма(Письмо), ЗаписьБлокировкиУчетнойЗаписи(ИмяУчетнойЗаписи)));
	Если СекундДержать > Прошло Тогда
		Наблюдать(СекундДержать - Прошло);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ДействияВКлиентеТестирования

// Проверка установки (PRD, «Установка и обновление», шаг 4): новое исходящее письмо открывается без ошибок.
&НаКлиенте
Процедура ЭтапНовоеПисьмо()

	ОсновноеОкно().ВыполнитьКоманду("e1cib/data/Документ.ЭлектронноеПисьмоИсходящее");
	ФормаПисьма = Неопределено;
	Конец = ТекущаяДата() + 30;
	Пока ФормаПисьма = Неопределено И ТекущаяДата() < Конец Цикл
		Пауза(1);
		ФормаПисьма = НайтиФорму("СписокПолучателей");
	КонецЦикла;
	Наблюдать(5);
	ВЖурнал("Новое письмо: " + ?(ФормаПисьма = Неопределено, "окно не открылось",
		"окно открылось, кнопки: " + СостояниеКнопок(ФормаПисьма)));
	ЗакрытьЛишниеОкна();

КонецПроцедуры

// П8 в копии базы и отключённое расширение: «Отправить», затем то же письмо из «Исходящих».
&НаКлиенте
Процедура ЭтапКопияБазы()

	ВЖурнал("Работа с внешними ресурсами заблокирована: " + РаботаСВнешнимиРесурсамиЗаблокирована());
	Письмо = СоздатьЧерновик("UI-проверка 11: копия базы", "Тест с сохранением");
	Отправить(Письмо, "");
	Наблюдать(30, Письмо);
	ВЖурнал("Письмо 11: " + СостояниеПисьма(Письмо));
	ЗакрытьЛишниеОкна();
	ВЖурнал("Письмо 11 открыто снова, кнопки: " + СостояниеКнопок(ОткрытьПисьмо(Письмо)));
	ЗакрытьЛишниеОкна();
	ПометитьНаУдаление(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Письмо));

КонецПроцедуры

// Разрешает работу с внешними ресурсами в копии базы. Сеансы, начатые раньше, видят блокировку до перезапуска.
&НаКлиенте
Процедура ЭтапРазблокировка()

	ВЖурнал("Работа с внешними ресурсами заблокирована: " + РаботаСВнешнимиРесурсамиЗаблокирована());
	РазрешитьРаботуСВнешнимиРесурсами();
	ВЖурнал("Работа с внешними ресурсами разрешена, заблокирована: " + РаботаСВнешнимиРесурсамиЗаблокирована());

КонецПроцедуры

&НаКлиенте
Процедура Подключиться(Порт)

	Приложение = Новый ТестируемоеПриложение("localhost", Порт);
	Конец = ТекущаяДата() + 120;
	Пока Истина Цикл
		Попытка
			Приложение.УстановитьСоединение();
			Прервать;
		Исключение
			Если ТекущаяДата() > Конец Тогда
				ВызватьИсключение;
			КонецЕсли;
			Пауза(2);
		КонецПопытки;
	КонецЦикла;
	// Клиент тестирования должен закончить запуск. Окна, открытые при запуске (например, подключение
	// Интернет-поддержки), закрыть: модальное окно не даст открыть письмо.
	Пауза(10);
	ВЖурнал("Подключено к клиенту тестирования");
	Наблюдать(0);
	ПодтвердитьКопиюБазы();
	ЗакрытьЛишниеОкна();

КонецПроцедуры

// В копии базы БСП при первом входе администратора спрашивает, копия это или перенесённая база.
// Отвечаем, как администратор копии: «Это копия информационной базы» — работа с внешними ресурсами заблокирована.
&НаКлиенте
Процедура ПодтвердитьКопиюБазы()

	Для Каждого ТестОкно Из Приложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если ТестОкно.Заголовок <> "Информационная база была перемещена или восстановлена из резервной копии" Тогда
			Продолжить;
		КонецЕсли;
		Кнопка = ТестОкно.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Это копия информационной базы");
		ВЖурнал("Окно БСП о перемещении базы: нажимаю «Это копия информационной базы»");
		Кнопка.Нажать();
		Пауза(3);
		Наблюдать(0);
	КонецЦикла;

КонецПроцедуры

// Закрывает несохранённое письмо вместе с остальными окнами; на вопрос о сохранении отвечает отказом.
&НаКлиенте
Процедура ЗакрытьПисьмоБезОтправки()

	ЗакрытьЛишниеОкна();
	Пауза(2);
	Наблюдать(0);
	Для Каждого Ответ Из СтрРазделить("Нет,Не сохранять,Закрыть без сохранения", ",") Цикл
		Кнопка = НайтиКнопкуВопроса(Ответ);
		Если Кнопка <> Неопределено Тогда
			ВЖурнал("Вопрос при закрытии письма: отвечаю «" + Кнопка.ТекстЗаголовка + "»");
			Кнопка.Нажать();
			Пауза(2);
			Наблюдать(0);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЗакрытьЛишниеОкна();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьЛишниеОкна()

	Для Каждого ТестОкно Из Приложение.ПолучитьПодчиненныеОбъекты() Цикл
		Если Не ТестОкно.Основное И ТестОкно.Заголовок <> "Начальная страница" Тогда
			ВЖурнал("Закрываю окно «" + ТестОкно.Заголовок + "»");
			ТестОкно.Закрыть();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Открывает письмо, нажимает «Отправить» и, если задан, отвечает на вопрос о сохранении.
&НаКлиенте
Процедура Отправить(Письмо, ОтветНаВопрос)

	НажатьОтправить(ОткрытьПисьмо(Письмо), Письмо, ОтветНаВопрос);

КонецПроцедуры

&НаКлиенте
Функция ОткрытьПисьмо(Письмо)

	ОсновноеОкно().ВыполнитьКоманду(НавигационнаяСсылка(Письмо));

	ФормаПисьма = Неопределено;
	Конец = ТекущаяДата() + 30;
	Пока ФормаПисьма = Неопределено И ТекущаяДата() < Конец Цикл
		Пауза(1);
		ФормаПисьма = НайтиФорму("СписокПолучателей");
	КонецЦикла;
	Если ФормаПисьма = Неопределено Тогда
		ВызватьИсключение "Форма письма не открылась";
	КонецЕсли;
	Возврат ФормаПисьма;

КонецФункции

&НаКлиенте
Процедура НажатьОтправить(ФормаПисьма, Письмо, ОтветНаВопрос)

	Кнопка = ФормаПисьма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "Отправить");
	ВЖурнал("Нажимаю «" + Кнопка.ТекстЗаголовка + "» в письме " + СокрЛП(Письмо));
	Кнопка.Нажать();

	Если ЗначениеЗаполнено(ОтветНаВопрос) Тогда
		Пауза(2);
		Наблюдать(0);
		Ответ = НайтиКнопкуВопроса(ОтветНаВопрос);
		Если Ответ = Неопределено Тогда
			ВызватьИсключение "Нет вопроса с кнопкой " + ОтветНаВопрос;
		КонецЕсли;
		ВЖурнал("Отвечаю «" + ОтветНаВопрос + "»");
		Ответ.Нажать();
	КонецЕсли;
	Пауза(2);
	Наблюдать(0);

КонецПроцедуры

// Видимость кнопок «Отправить»/«Отправить сейчас» и «Записать и закрыть» в форме письма.
&НаКлиенте
Функция СостояниеКнопок(ФормаПисьма)

	Если ФормаПисьма = Неопределено Тогда
		Возврат "окна письма нет";
	КонецЕсли;
	Отправить = ФормаПисьма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "Отправить");
	ЗаписатьИЗакрыть = ФормаПисьма.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), , "ФормаЗаписатьИЗакрыть");
	Возврат СтрШаблон("«%1» %2, «Записать и закрыть» %3",
		?(Отправить = Неопределено, "Отправить", Отправить.ТекстЗаголовка), ВидимостьКнопки(Отправить),
		ВидимостьКнопки(ЗаписатьИЗакрыть));

КонецФункции

