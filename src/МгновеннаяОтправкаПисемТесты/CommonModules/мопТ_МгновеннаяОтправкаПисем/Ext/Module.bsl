// Фоновое задание-заглушка для НачатьОтправку_УжеОтправляется: держит ключ письма занятым.
//
// Параметры:
//  Секунд - Число
//  АдресРезультата - Строка
//
Процедура ПодождатьВФоне(Секунд, АдресРезультата) Экспорт

	ПодождатьПоСекунде(Секунд);

КонецПроцедуры

// Фоновое задание-заглушка: держит письмо занятым для редактирования, как форма другого пользователя
// с несохранённой правкой. Блокировка снимается, когда задание завершается.
//
// Параметры:
//  Параметры - Структура - Письмо, Секунд.
//  АдресРезультата - Строка
//
Процедура ЗанятьПисьмоВФоне(Параметры, АдресРезультата) Экспорт

	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	// Тест проверяет, занято ли письмо, пробной блокировкой: в этот момент письмо может быть занято им.
	Для НомерПовтора = 1 По 10 Цикл
		Попытка
			ЗаблокироватьДанныеДляРедактирования(Параметры.Письмо);
			Прервать;
		Исключение
			Если НомерПовтора = 10 Или ТекущееЗадание = Неопределено Тогда
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
		ТекущееЗадание.ОжидатьЗавершенияВыполнения(1);
	КонецЦикла;
	ПодождатьПоСекунде(Параметры.Секунд);

КонецПроцедуры

// Ждёт внутри фонового задания по секунде: отмена задания срабатывает между ожиданиями,
// а в файловой базе следующее фоновое задание теста не запустится, пока это не завершится.
Процедура ПодождатьПоСекунде(Секунд)

	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ТекущееЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для НомерСекунды = 1 По Секунд Цикл
		ТекущееЗадание.ОжидатьЗавершенияВыполнения(1);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

