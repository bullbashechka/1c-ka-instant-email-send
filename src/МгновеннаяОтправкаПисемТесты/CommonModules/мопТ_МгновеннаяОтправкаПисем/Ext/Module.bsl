		.ДобавитьСерверныйТест("Захват_БрошеннаяЗабирается",
			"Запись моложе 60 минут без живого владельца забирается").ВТранзакции()
		.ДобавитьСерверныйТест("Захват_СтаршеЧасаЗабирается",
			"Запись старше 60 минут считается снятой").ВТранзакции()
