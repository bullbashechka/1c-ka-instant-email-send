	Исключение
		ЗавершитьЗапускИУдалитьПисьмо(Письмо, Запуск);
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьЗапускИУдалитьПисьмо(Письмо, Запуск);

КонецПроцедуры

