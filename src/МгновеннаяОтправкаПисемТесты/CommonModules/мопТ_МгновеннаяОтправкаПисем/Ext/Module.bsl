Процедура СверкаПисьмаСБазой_ВсеСочетания() Экспорт

	Для Каждого Статус Из Метаданные.Перечисления.СтатусыИсходящегоЭлектронногоПисьма.ЗначенияПеречисления Цикл
		СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма[Статус.Имя];
		Для Каждого Помечено Из ЗначенияБулево() Цикл
			Если СтатусПисьма = Черновик() Или Помечено Тогда
				Ожидается = "Переоткрыть";
			ИначеЕсли СтатусПисьма = Отправлено() Тогда
				Ожидается = "Отправлено";
			Иначе
				Ожидается = "Отправлять";
			КонецЕсли;
			Сочетание = СтрШаблон("%1, пометка %2", СтатусПисьма, Помечено);
			ЮТест.ОжидаетЧто(моп_МгновеннаяОтправкаПисем.СверкаПисьмаСБазой(Истина, СтатусПисьма, Помечено), Сочетание)
				.Равно(Ожидается);
		КонецЦикла;
	КонецЦикла;

	ЮТест.ОжидаетЧто(моп_МгновеннаяОтправкаПисем.СверкаПисьмаСБазой(Ложь, Неопределено, Неопределено), "Письма нет")
		.Равно("Закрыть");

