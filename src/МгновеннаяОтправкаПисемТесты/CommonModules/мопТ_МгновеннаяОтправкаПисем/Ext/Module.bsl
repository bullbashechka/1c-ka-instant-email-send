#Область СлужебныеПроцедурыИФункции

// Правила из PRD, раздел «Техническая реализация», функция ДоступностьОтправки.
Функция ОжидаемаяДоступность(СтатусПисьма, КогдаОтправить, НеОтправлятьПосле, Помечено, Заблокированы, Сейчас)

	Результат = Новый Структура("Доступна, ТекстОтказа", Ложь, "");
	Если Заблокированы Тогда
		Результат.ТекстОтказа = ТекстВнешниеРесурсыЗаблокированы();
	ИначеЕсли ЗначениеЗаполнено(НеОтправлятьПосле) И НеОтправлятьПосле <= Сейчас Тогда
		Результат.ТекстОтказа = ТекстИстёкСрок();
	ИначеЕсли Помечено Тогда
		// Регламентное задание помеченные письма не отправляет.
	ИначеЕсли СтатусПисьма = Черновик() И ЗначениеЗаполнено(КогдаОтправить) И КогдаОтправить >= Сейчас Тогда
		// Обычная отложенная отправка.
	ИначеЕсли СтатусПисьма = Черновик() Или СтатусПисьма = Исходящее() Тогда
		Результат.Доступна = Истина;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ТекстВнешниеРесурсыЗаблокированы()
	Возврат "Письмо не отправлено: работа с внешними ресурсами заблокирована";
КонецФункции

Функция ТекстПисьмоРедактируется()
