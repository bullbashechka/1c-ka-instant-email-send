Процедура ДоступностьОтправки_ВсеСочетания() Экспорт

	Сейчас = ТекущаяДатаСеанса();
	Даты = Новый Массив;
	Даты.Добавить(Дата(1, 1, 1));
	Даты.Добавить(Сейчас - 3600);
	Даты.Добавить(Сейчас + 3600);

	Для Каждого Статус Из Метаданные.Перечисления.СтатусыИсходящегоЭлектронногоПисьма.ЗначенияПеречисления Цикл
		СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма[Статус.Имя];
		Для Каждого КогдаОтправить Из Даты Цикл
			Для Каждого НеОтправлятьПосле Из Даты Цикл
				Для Каждого Помечено Из ЗначенияБулево() Цикл
				Для Каждого Заблокированы Из ЗначенияБулево() Цикл

					Ожидается = ОжидаемаяДоступность(СтатусПисьма, КогдаОтправить, НеОтправлятьПосле, Помечено,
						Заблокированы, Сейчас);
					Результат = моп_МгновеннаяОтправкаПисемКлиентСервер.ДоступностьОтправки(
						СтатусПисьма, КогдаОтправить, НеОтправлятьПосле, Помечено, Заблокированы, Сейчас);

					Сочетание = СтрШаблон("%1, когда %2, не после %3, пометка %4, блокировка %5",
						СтатусПисьма, КогдаОтправить, НеОтправлятьПосле, Помечено, Заблокированы);
					ЮТест.ОжидаетЧто(Результат.Доступна, Сочетание).Равно(Ожидается.Доступна);
					ЮТест.ОжидаетЧто(Результат.ТекстОтказа, Сочетание).Равно(Ожидается.ТекстОтказа);

				КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

