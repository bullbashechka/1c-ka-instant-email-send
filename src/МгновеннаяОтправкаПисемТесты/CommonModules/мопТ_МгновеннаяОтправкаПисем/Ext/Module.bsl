Процедура НачатьОтправку_УжеОтправляется() Экспорт

	Письмо = Документы.ЭлектронноеПисьмоИсходящее.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Ключ = "моп_ОтправкаПисьма_" + Письмо.УникальныйИдентификатор();

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Неопределено);
	ПараметрыВыполнения.КлючФоновогоЗадания = Ключ;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	Заглушка = ДлительныеОперации.ВыполнитьВФоне("мопТ_МгновеннаяОтправкаПисем.ПодождатьВФоне", 30, ПараметрыВыполнения);

	Попытка
		ЮТест.ОжидаетЧто(Заглушка.Статус, "Задание-заглушка").Равно("Выполняется");

		Запуск = моп_МгновеннаяОтправкаПисем.НачатьОтправку(Письмо, Ложь, Ложь);

		ЮТест.ОжидаетЧто(Запуск.УжеОтправляется, "Уже отправляется").ЭтоИстина();
		ЮТест.ОжидаетЧто(Запуск.ДлительнаяОперация, "Длительная операция").Равно(Неопределено);
		Отбор = Новый Структура("Ключ, Состояние", Ключ, СостояниеФоновогоЗадания.Активно);
		ЮТест.ОжидаетЧто(ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество(), "Заданий с ключом письма").Равно(1);
	Исключение
		ОстановитьЗаглушку(Заглушка, ПараметрыВыполнения.АдресРезультата);
		ВызватьИсключение;
	КонецПопытки;
	ОстановитьЗаглушку(Заглушка, ПараметрыВыполнения.АдресРезультата);

КонецПроцедуры

// Без транзакции: задание читает письмо из базы. Письмо с истёкшим сроком не уходит, но проходит весь путь запуска.
Процедура НачатьОтправку_ЗапускаетОтправку() Экспорт

	Если ИдётПолучениеПочты() Тогда
		ЮТест.Пропустить("В базе идёт получение почты: задание отправки ждало бы его до 5 минут");
		Возврат;
	КонецЕсли;

	УдалитьОстаткиПрошлыхПрогонов();
	Письмо = НовоеПисьмоВнеТранзакции(Исходящее(), ТекущаяДатаСеанса() - 60);
	Запуск = Неопределено;
	Попытка
		ЗаписатьОтказ(Письмо);

		Запуск = моп_МгновеннаяОтправкаПисем.НачатьОтправку(Письмо, Ложь, Истина);

		ЮТест.ОжидаетЧто(Запуск.ТекстОтказа, "Текст отказа").Равно("");
		ЮТест.ОжидаетЧто(Запуск.УжеОтправляется, "Уже отправляется").ЭтоЛожь();
		ЮТест.ОжидаетЧто(ЕстьОтказ(Письмо), "Отказ регламентного задания").ЭтоЛожь();
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Запуск.ДлительнаяОперация.ИдентификаторЗадания);
		ЮТест.ОжидаетЧто(Задание.Ключ, "Ключ задания").Равно("моп_ОтправкаПисьма_" + Письмо.УникальныйИдентификатор());
		ЮТест.ОжидаетЧто(Задание.Наименование, "Наименование задания").Равно(
			моп_МгновеннаяОтправкаПисем.НаименованиеЗаданияОтправки(Письмо.УчетнаяЗапись.УникальныйИдентификатор()));

		Задание.ОжидатьЗавершенияВыполнения(120);
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Запуск.ДлительнаяОперация.ИдентификаторЗадания);
		ЮТест.ОжидаетЧто(Задание.Состояние, "Состояние задания").Равно(СостояниеФоновогоЗадания.Завершено);

		Результат = ПолучитьИзВременногоХранилища(Запуск.ДлительнаяОперация.АдресРезультата);
		ЮТест.ОжидаетЧто(Результат.Итог, "Итог").Равно("НеОтправлено");
		ЮТест.ОжидаетЧто(Результат.ТекстСообщения, "Текст").Равно(ТекстИстёкСрок());
		ЮТест.ОжидаетЧто(Письмо.СтатусПисьма, "Статус").Равно(Исходящее());
		ЮТест.ОжидаетЧто(Письмо.ДатаКогдаОтправить, "Когда отправить").Равно(Дата(1, 1, 1));
