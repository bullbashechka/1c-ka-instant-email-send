// Результат с полями, которые заполняет ЗавершитьОжиданиеУчетнойЗаписи, см. моп_МгновеннаяОтправкаПисем.ВыполнитьОтправку.
Функция ЗавершитьОжидание(Письмо, УчетнаяЗапись)
	Результат = Новый Структура("Итог, ТекстСообщения, Тема, ОшибкаПодключения", "", "", "", Ложь);
	моп_МгновеннаяОтправкаПисем.ЗавершитьОжиданиеУчетнойЗаписи(Письмо, УчетнаяЗапись, 1, Результат);
	Возврат Результат;
КонецФункции

Процедура ЗаписатьБлокировку(УчетнаяЗапись, ДатаБлокировки)
	МенеджерЗаписи = РегистрыСведений.ЗаблокированныеДляПолученияУчетныеЗаписи.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗапись;
	МенеджерЗаписи.ДатаБлокировки = ДатаБлокировки;
	МенеджерЗаписи.Записать();
КонецПроцедуры

Функция ДатаБлокировки(УчетнаяЗапись)
	МенеджерЗаписи = РегистрыСведений.ЗаблокированныеДляПолученияУчетныеЗаписи.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗапись;
	МенеджерЗаписи.Прочитать();
	Возврат ?(МенеджерЗаписи.Выбран(), МенеджерЗаписи.ДатаБлокировки, Неопределено);
КонецФункции

Процедура ЗаписатьОтказ(Письмо)
	МенеджерЗаписи = РегистрыСведений.НепринятыеКОбработкеПочтовымСерверомИсходящиеПисьма.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Письмо = Письмо;
	МенеджерЗаписи.КоличествоПопыток = 5;
	МенеджерЗаписи.Записать();
КонецПроцедуры

Функция ЕстьОтказ(Письмо)
	МенеджерЗаписи = РегистрыСведений.НепринятыеКОбработкеПочтовымСерверомИсходящиеПисьма.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Письмо = Письмо;
	МенеджерЗаписи.Прочитать();
	Возврат МенеджерЗаписи.Выбран();
КонецФункции

// Письмо по умолчанию через системную учётную запись. Тесты отправки передают несуществующую учётную запись,
// чтобы письмо нельзя было отправить даже при ошибке в коде. Транзакция теста откатывается.
Функция НовоеПисьмо(Статус, КогдаОтправить = '00010101', УдалятьПослеОтправки = Ложь, УчетнаяЗапись = Неопределено,
	НеОтправлятьПосле = '00010101')
	ПисьмоОбъект = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	ПисьмоОбъект.Дата = ТекущаяДатаСеанса();
	ПисьмоОбъект.Тема = "мопТ: тестовое письмо";
	ПисьмоОбъект.УчетнаяЗапись = ?(УчетнаяЗапись = Неопределено,
		Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты, УчетнаяЗапись);
	ПисьмоОбъект.ДатаАктуальностиОтправки = НеОтправлятьПосле;
	ПисьмоОбъект.СтатусПисьма = Статус;
	ПисьмоОбъект.ДатаКогдаОтправить = КогдаОтправить;
	ПисьмоОбъект.УдалятьПослеОтправки = УдалятьПослеОтправки;
	ПисьмоОбъект.Записать();
	Возврат ПисьмоОбъект.Ссылка;
КонецФункции

// Письмо для тестов без транзакции: с несуществующей учётной записью и без записей регистров взаимодействий,
// чтобы удаление в конце теста не оставило в базе следов.
Функция НовоеПисьмоВнеТранзакции(Статус, НеОтправлятьПосле = '00010101')
	ПисьмоОбъект = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	ПисьмоОбъект.Дата = ТекущаяДатаСеанса();
	ПисьмоОбъект.Тема = "мопТ: тестовое письмо";
	ПисьмоОбъект.УчетнаяЗапись = НесуществующаяУчетнаяЗапись();
	ПисьмоОбъект.СтатусПисьма = Статус;
	ПисьмоОбъект.ДатаАктуальностиОтправки = НеОтправлятьПосле;
	ПисьмоОбъект.ОбменДанными.Загрузка = Истина;
	ПисьмоОбъект.Записать();
	Возврат ПисьмоОбъект.Ссылка;
КонецФункции

// Запускает ЗанятьПисьмоВФоне и ждёт, пока задание займёт письмо.
//
// Возвращаемое значение:
//  см. ДлительныеОперации.ВыполнитьВФоне - со свойством АдресРезультата.
//
Функция ЗанятьПисьмоДругимСеансом(Письмо)
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Неопределено);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	Заглушка = ДлительныеОперации.ВыполнитьВФоне("мопТ_МгновеннаяОтправкаПисем.ЗанятьПисьмоВФоне",
		Новый Структура("Письмо, Секунд", Письмо, 60), ПараметрыВыполнения);
	Заглушка.Вставить("АдресРезультата", ПараметрыВыполнения.АдресРезультата);
	ЮТест.ОжидаетЧто(Заглушка.Статус, "Задание-заглушка").Равно("Выполняется");

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Заглушка.ИдентификаторЗадания);
	// В файловой базе фоновое задание стартует через несколько секунд, а за другим заданием — и через полминуты.
	Для НомерОжидания = 1 По 60 Цикл
		Попытка
			ЗаблокироватьДанныеДляРедактирования(Письмо);
			РазблокироватьДанныеДляРедактирования(Письмо);
		Исключение
			Возврат Заглушка;
		КонецПопытки;
		Задание.ОжидатьЗавершенияВыполнения(1);
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Задание-заглушка не заняло письмо: %1 %2", Задание.Состояние,
		?(Задание.ИнформацияОбОшибке = Неопределено, "", ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке)));
КонецФункции

Процедура ОсвободитьИУдалитьПисьмо(Письмо, Заглушка)
	Если Заглушка <> Неопределено Тогда
		ОстановитьЗаглушку(Заглушка, Заглушка.АдресРезультата);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	НаборЗаписей = РегистрыСведений.НепринятыеКОбработкеПочтовымСерверомИсходящиеПисьма.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Письмо.Установить(Письмо);
	НаборЗаписей.Записать();
	ПисьмоОбъект = Письмо.ПолучитьОбъект();
	Если ПисьмоОбъект <> Неопределено Тогда
		// Обычное удаление: подписки КА убирают наборы значений доступа, которые письму записала фоновая отправка.
		ПисьмоОбъект.Удалить();
	КонецЕсли;
КонецПроцедуры

// Отправка при занятой учётной записи. Блокировку держит живой владелец: задание-заглушка с наименованием
// мгновенной отправки. В клиент-серверной базе блокировку без живого владельца отправка забрала бы (П21).
Функция ВыполнитьОтправкуПриЗанятойУчетнойЗаписи(Письмо, ДатаБлокировки)
	ЗаписатьБлокировку(Письмо.УчетнаяЗапись, ДатаБлокировки);
	Заглушка = ЗапуститьЗаглушку(
		моп_МгновеннаяОтправкаПисем.НаименованиеЗаданияОтправки(Письмо.УчетнаяЗапись.УникальныйИдентификатор()));
	Попытка
		Результат = ВыполнитьОтправку(Письмо);
	Исключение
		ОстановитьЗаглушку(Заглушка, Заглушка.АдресРезультата);
		ВызватьИсключение;
	КонецПопытки;
	ОстановитьЗаглушку(Заглушка, Заглушка.АдресРезультата);
	Возврат Результат;
КонецФункции

Функция ВыполнитьОтправку(Письмо)
	Возврат моп_МгновеннаяОтправкаПисем.ВыполнитьОтправку(Письмо, Письмо.УчетнаяЗапись, Неопределено);
КонецФункции

// Папка и правило обработки почты «письма с темой тестового письма в эту папку».
// Настройки — как в типовой форме правила: по умолчанию из схемы плюс отбор.
// Пишутся с ОбменДанными.Загрузка: типовая проверка ответственного за папки здесь не нужна.
Функция ПравилоТемаВПапку(УчетнаяЗапись, Тема)
	Папка = Справочники.ПапкиЭлектронныхПисем.СоздатьЭлемент();
	Папка.Владелец = УчетнаяЗапись;
	Папка.Наименование = "мопТ: папка правила";
	Папка.ОбменДанными.Загрузка = Истина;
	Папка.Записать();

	Правило = Справочники.ПравилаОбработкиЭлектроннойПочты.СоздатьЭлемент();
	Правило.Владелец = УчетнаяЗапись;
	Правило.Наименование = "мопТ: письма с темой тестового письма";
	Правило.ПомещатьВПапку = Папка.Ссылка;
	Схема = Справочники.ПравилаОбработкиЭлектроннойПочты.ПолучитьМакет("СхемаПравилаОбработкиЭлектроннойПочты");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Компоновщик.Настройки.Отбор, "Тема", Тема);
	Правило.КомпоновщикНастроек = Новый ХранилищеЗначения(Компоновщик.ПолучитьНастройки());
	Правило.ОбменДанными.Загрузка = Истина;
	Правило.Записать();

	Возврат Папка.Ссылка;
КонецФункции

Функция ПапкаПисьма(Письмо)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПредметыПапкиВзаимодействий.ПапкаЭлектронногоПисьма КАК Папка
	|ИЗ
	|	РегистрСведений.ПредметыПапкиВзаимодействий КАК ПредметыПапкиВзаимодействий
	|ГДЕ
	|	ПредметыПапкиВзаимодействий.Взаимодействие = &Письмо");
	Запрос.УстановитьПараметр("Письмо", Письмо);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Папка, Неопределено);
КонецФункции

// Задание отправки должно завершиться до удаления письма, иначе оно писало бы в удаляемое письмо.
Процедура ЗавершитьЗапускИУдалитьПисьмо(Письмо, Запуск)
	Если Запуск <> Неопределено И Запуск.ДлительнаяОперация <> Неопределено Тогда
		Если ЗначениеЗаполнено(Запуск.ДлительнаяОперация.ИдентификаторЗадания) Тогда
			ДлительныеОперации.ОтменитьВыполнениеЗадания(Запуск.ДлительнаяОперация.ИдентификаторЗадания);
			Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Запуск.ДлительнаяОперация.ИдентификаторЗадания);
			Если Задание <> Неопределено Тогда
				Задание.ОжидатьЗавершенияВыполнения(30);
			КонецЕсли;
		КонецЕсли;
		Если ЭтоАдресВременногоХранилища(Запуск.ДлительнаяОперация.АдресРезультата) Тогда
			УдалитьИзВременногоХранилища(Запуск.ДлительнаяОперация.АдресРезультата);
		КонецЕсли;
	КонецЕсли;
	ОсвободитьИУдалитьПисьмо(Письмо, Неопределено);
КонецПроцедуры

// Тесты без транзакции пишут письмо в базу, и оборванный прогон оставил бы его там. Письма теста
// узнаются по теме и по учётной записи, которой нет в базе; настоящие письма под это условие не попадают.
Процедура УдалитьОстаткиПрошлыхПрогонов()
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Письма.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭлектронноеПисьмоИсходящее КАК Письма
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиЭлектроннойПочты КАК УчетныеЗаписи
	|		ПО Письма.УчетнаяЗапись = УчетныеЗаписи.Ссылка
	|ГДЕ
	|	Письма.Тема = &Тема
	|	И УчетныеЗаписи.Ссылка ЕСТЬ NULL");
	Запрос.УстановитьПараметр("Тема", "мопТ: тестовое письмо");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОсвободитьИУдалитьПисьмо(Выборка.Ссылка, Неопределено);
	КонецЦикла;
КонецПроцедуры

Процедура ОстановитьЗаглушку(Заглушка, АдресРезультата)
	Если ЗначениеЗаполнено(Заглушка.ИдентификаторЗадания) Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(Заглушка.ИдентификаторЗадания);
		// Заглушка снимает свою блокировку письма, а в файловой базе освобождает очередь фоновых заданий.
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Заглушка.ИдентификаторЗадания);
		Если Задание <> Неопределено Тогда
			Задание.ОжидатьЗавершенияВыполнения(10);
		КонецЕсли;
	КонецЕсли;
	УдалитьИзВременногоХранилища(АдресРезультата);
КонецПроцедуры

// Наименование фонового задания команды «Отправить и получить почту»: его задаёт ВзаимодействияВызовСервера.
Функция НаименованиеЗаданияКомандыПочты()
	Возврат "Получение и отправка электронной почты пользователя";
КонецФункции

// Идёт ли в базе получение почты: регламентное задание или «Отправить и получить почту».
// При нём тесты, которые рассчитывают на отсутствие таких заданий, пропускаются.
Функция ИдётПолучениеПочты()
	Отбор = Новый Структура("ИмяМетода, Состояние",
		Метаданные.РегламентныеЗадания.ПолучениеИОтправкаЭлектронныхПисем.ИмяМетода, СостояниеФоновогоЗадания.Активно);
	Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Отбор = Новый Структура("Наименование, Состояние", НаименованиеЗаданияКомандыПочты(), СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0;
КонецФункции

// Запускает задание-заглушку с заданным наименованием. Останавливать через ОстановитьЗаглушку.
//
// Возвращаемое значение:
//  см. ДлительныеОперации.ВыполнитьВФоне - со свойством АдресРезультата.
//
Функция ЗапуститьЗаглушку(Наименование, Секунд = 60)
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Неопределено);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = Наименование;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	Заглушка = ДлительныеОперации.ВыполнитьВФоне("мопТ_МгновеннаяОтправкаПисем.ПодождатьВФоне", Секунд, ПараметрыВыполнения);
	Заглушка.Вставить("АдресРезультата", ПараметрыВыполнения.АдресРезультата);
	ЮТест.ОжидаетЧто(Заглушка.Статус, "Задание-заглушка").Равно("Выполняется");
	Возврат Заглушка;
КонецФункции

// В файловой базе фоновое задание стартует через несколько секунд: Начало заполняется, когда оно началось.
Функция ДождатьсяНачалаЗаглушки(Заглушка)
	Для НомерОжидания = 1 По 60 Цикл
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Заглушка.ИдентификаторЗадания);
		Если ЗначениеЗаполнено(Задание.Начало) Тогда
			Возврат Задание.Начало;
		КонецЕсли;
		Задание.ОжидатьЗавершенияВыполнения(1);
	КонецЦикла;
	ВызватьИсключение "Задание-заглушка не началось за 60 секунд";
КонецФункции

// Несохранённое письмо с получателями «Кому».
Функция ПисьмоСПолучателями(Адрес1, Адрес2)
	ПисьмоОбъект = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	ПисьмоОбъект.Тема = "мопТ: тестовое письмо";
	ПисьмоОбъект.Дата = ТекущаяДатаСеанса();
	Для Каждого Адрес Из СтрРазделить(Адрес1 + "," + Адрес2, ",") Цикл
		Строка = ПисьмоОбъект.ПолучателиПисьма.Добавить();
		Строка.Адрес = Адрес;
		Строка.Представление = Адрес;
	КонецЦикла;
	Возврат ПисьмоОбъект;
КонецФункции

#КонецОбласти
