	ЮТест.ОжидаетЧто(Результат.ПисьмоПринятоСервером, "Принято сервером").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Письмо.СтатусПисьма, "Статус").Равно(Исходящее());
	ЮТест.ОжидаетЧто(Письмо.ДатаКогдаОтправить, "Когда отправить").Равно(Дата(1, 1, 1));
	
КонецПроцедуры

Процедура Отправка_УчетнаяЗаписьЗанята() Экспорт
	
	Если Не ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		// В клиент-серверной базе блокировка без живого владельца забирается (П21).
		Возврат;
	КонецЕсли;
	
	Письмо = НовоеПисьмо(Исходящее(), ТекущаяДатаСеанса() + 600, , НесуществующаяУчетнаяЗапись());
	Чужая = ТекущаяДатаСеанса() - 10;
	ЗаписатьБлокировку(Письмо.УчетнаяЗапись, Чужая);
	
	Результат = ВыполнитьОтправку(Письмо);
	
	ЮТест.ОжидаетЧто(Результат.Итог, "Итог").Равно("НеОтправлено");
	ЮТест.ОжидаетЧто(Результат.ТекстСообщения, "Текст").Равно("Учетная запись занята получением или отправкой почты");
	ЮТест.ОжидаетЧто(Результат.ОшибкаПодключения, "Ошибка почтового сервера").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Письмо.ДатаКогдаОтправить, "Когда отправить").Равно(Дата(1, 1, 1));
	ЮТест.ОжидаетЧто(ДатаБлокировки(Письмо.УчетнаяЗапись), "Чужая блокировка").Равно(Чужая);
	
КонецПроцедуры

Процедура СостояниеОтправки_Отправлено() Экспорт
	
	Письмо = НовоеПисьмо(Отправлено(), , , НесуществующаяУчетнаяЗапись());
	
	Состояние = моп_МгновеннаяОтправкаПисемВызовСервера.СостояниеОтправки(Письмо);
	
	ЮТест.ОжидаетЧто(Состояние.Отправлено, "Отправлено").ЭтоИстина();
	ЮТест.ОжидаетЧто(Состояние.Удалено, "Удалено").ЭтоЛожь();
	
КонецПроцедуры

Процедура СостояниеОтправки_НеОтправлено() Экспорт
	
	Статусы = Новый Массив;
	Статусы.Добавить(Исходящее());
	Статусы.Добавить(Черновик());
	Для Каждого Статус Из Статусы Цикл
		Письмо = НовоеПисьмо(Статус, , , НесуществующаяУчетнаяЗапись());
		
		Состояние = моп_МгновеннаяОтправкаПисемВызовСервера.СостояниеОтправки(Письмо);
		
		ЮТест.ОжидаетЧто(Состояние.Отправлено, "Отправлено: " + Статус).ЭтоЛожь();
		ЮТест.ОжидаетЧто(Состояние.Удалено, "Удалено: " + Статус).ЭтоЛожь();
	КонецЦикла;
	
КонецПроцедуры

Процедура СостояниеОтправки_Удалено() Экспорт
	
	Письмо = Документы.ЭлектронноеПисьмоИсходящее.ПолучитьСсылку(Новый УникальныйИдентификатор);
	
	Состояние = моп_МгновеннаяОтправкаПисемВызовСервера.СостояниеОтправки(Письмо);
	
	ЮТест.ОжидаетЧто(Состояние.Отправлено, "Отправлено").ЭтоИстина();
	ЮТест.ОжидаетЧто(Состояние.Удалено, "Удалено").ЭтоИстина();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Правила из PRD, раздел «Техническая реализация», функция ДоступностьОтправки.
Функция ОжидаемаяДоступность(СтатусПисьма, КогдаОтправить, НеОтправлятьПосле, Заблокированы, Сейчас)

	Результат = Новый Структура("Доступна, ТекстОтказа", Ложь, "");
	Если Заблокированы Тогда
		Результат.ТекстОтказа = ТекстВнешниеРесурсыЗаблокированы();
	ИначеЕсли ЗначениеЗаполнено(НеОтправлятьПосле) И НеОтправлятьПосле <= Сейчас Тогда
		Результат.ТекстОтказа = ТекстИстёкСрок();
	ИначеЕсли СтатусПисьма = Черновик() И ЗначениеЗаполнено(КогдаОтправить) И КогдаОтправить >= Сейчас Тогда
		// Обычная отложенная отправка.
	ИначеЕсли СтатусПисьма = Черновик() Или СтатусПисьма = Исходящее() Тогда
		Результат.Доступна = Истина;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ТекстВнешниеРесурсыЗаблокированы()
	Возврат "Письмо не отправлено: работа с внешними ресурсами заблокирована";
КонецФункции

Функция ТекстИстёкСрок()
	Возврат "Письмо не отправлено: истёк срок, указанный в поле «Не отправлять после»";
КонецФункции

Функция Черновик()
	Возврат Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Черновик;
КонецФункции

Функция Исходящее()
	Возврат Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее;
КонецФункции

Функция Отправлено()
	Возврат Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Отправлено;
КонецФункции

Функция ЗначенияБулево()
	Значения = Новый Массив;
	Значения.Добавить(Ложь);
	Значения.Добавить(Истина);
	Возврат Значения;
КонецФункции

Функция НесуществующаяУчетнаяЗапись()
	Возврат Справочники.УчетныеЗаписиЭлектроннойПочты.ПолучитьСсылку(Новый УникальныйИдентификатор);
КонецФункции

Процедура ЗаписатьБлокировку(УчетнаяЗапись, ДатаБлокировки)
	МенеджерЗаписи = РегистрыСведений.ЗаблокированныеДляПолученияУчетныеЗаписи.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗапись;
	МенеджерЗаписи.ДатаБлокировки = ДатаБлокировки;
	МенеджерЗаписи.Записать();
КонецПроцедуры

Функция ДатаБлокировки(УчетнаяЗапись)
	МенеджерЗаписи = РегистрыСведений.ЗаблокированныеДляПолученияУчетныеЗаписи.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗапись;
	МенеджерЗаписи.Прочитать();
	Возврат ?(МенеджерЗаписи.Выбран(), МенеджерЗаписи.ДатаБлокировки, Неопределено);
КонецФункции

Процедура ЗаписатьОтказ(Письмо)
	МенеджерЗаписи = РегистрыСведений.НепринятыеКОбработкеПочтовымСерверомИсходящиеПисьма.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Письмо = Письмо;
	МенеджерЗаписи.КоличествоПопыток = 5;
	МенеджерЗаписи.Записать();
КонецПроцедуры

Функция ЕстьОтказ(Письмо)
	МенеджерЗаписи = РегистрыСведений.НепринятыеКОбработкеПочтовымСерверомИсходящиеПисьма.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Письмо = Письмо;
	МенеджерЗаписи.Прочитать();
	Возврат МенеджерЗаписи.Выбран();
КонецФункции

// Письмо по умолчанию через системную учётную запись. Тесты отправки передают несуществующую учётную запись,
// чтобы письмо нельзя было отправить даже при ошибке в коде. Транзакция теста откатывается.
Функция НовоеПисьмо(Статус, КогдаОтправить = '00010101', УдалятьПослеОтправки = Ложь, УчетнаяЗапись = Неопределено,
	НеОтправлятьПосле = '00010101')
	ПисьмоОбъект = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	ПисьмоОбъект.Дата = ТекущаяДатаСеанса();
	ПисьмоОбъект.Тема = "мопТ: тестовое письмо";
	ПисьмоОбъект.УчетнаяЗапись = ?(УчетнаяЗапись = Неопределено,
		Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты, УчетнаяЗапись);
	ПисьмоОбъект.ДатаАктуальностиОтправки = НеОтправлятьПосле;
	ПисьмоОбъект.СтатусПисьма = Статус;
	ПисьмоОбъект.ДатаКогдаОтправить = КогдаОтправить;
	ПисьмоОбъект.УдалятьПослеОтправки = УдалятьПослеОтправки;
	ПисьмоОбъект.Записать();
	Возврат ПисьмоОбъект.Ссылка;
КонецФункции

Функция ВыполнитьОтправку(Письмо)
	Возврат моп_МгновеннаяОтправкаПисем.ВыполнитьОтправку(Письмо, Письмо.УчетнаяЗапись, Неопределено);
КонецФункции

#КонецОбласти
