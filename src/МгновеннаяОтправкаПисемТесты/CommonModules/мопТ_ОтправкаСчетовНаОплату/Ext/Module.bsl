#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ТемаПисьмаСчетов_ОдинСчет",
			"Один счёт: номер без префиксов и ведущих нулей, дата в коротком формате")
		.ДобавитьСерверныйТест("ТемаПисьмаСчетов_НесколькоСчетов",
			"Несколько счетов: по дате, затем по номеру, одинаковые не повторяются")

		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_Счет",
			"Счёт заменяет тему «Документы» на «Счет на оплату № … от …»").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_НесколькоСчетов",
			"Несколько счетов в письме перечислены в теме по дате").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_НеСчет",
			"Печатная форма другого документа тему не меняет").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_СчетИДругойДокумент",
			"Счёт вместе с другим документом тему не меняет").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_СчётНеНайден",
			"Несуществующий счёт тему не меняет и ошибки не даёт").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_НетОбъектов",
			"Без объектов печати тема не меняется");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТемаПисьмаСчетов_ОдинСчет() Экспорт

	ДанныеСчетов = Новый Массив;
	ДанныеСчетов.Добавить(ДанныеСчета("ТЕ00-000123", Дата(2026, 10, 20)));

	ЮТест.ОжидаетЧто(моп_ОтправкаСчетовНаОплату.ТемаПисьмаСчетов(ДанныеСчетов))
		.Равно("Счет на оплату № 123 от 20.10.2026");

КонецПроцедуры

Процедура ТемаПисьмаСчетов_НесколькоСчетов() Экспорт

	ДанныеСчетов = Новый Массив;
	ДанныеСчетов.Добавить(ДанныеСчета("ТЕ00-000002", Дата(2026, 10, 21)));
	ДанныеСчетов.Добавить(ДанныеСчета("ТЕ00-000003", Дата(2026, 10, 20)));
	ДанныеСчетов.Добавить(ДанныеСчета("ТЕ00-000001", Дата(2026, 10, 20)));
	ДанныеСчетов.Добавить(ДанныеСчета("ТЕ00-000002", Дата(2026, 10, 21)));

	ЮТест.ОжидаетЧто(моп_ОтправкаСчетовНаОплату.ТемаПисьмаСчетов(ДанныеСчетов))
		.Равно("Счет на оплату № 1 от 20.10.2026, № 3 от 20.10.2026, № 2 от 21.10.2026");

КонецПроцедуры

Процедура ПередОтправкойПоПочте_Счет() Экспорт

	Счет = НовыйСчет("ТЕ00-000123", Дата(2026, 10, 20));

	ПараметрыОтправки = ВызватьПередОтправкойПоПочте(ОбъектыПечати(Счет));

	ЮТест.ОжидаетЧто(ПараметрыОтправки.Тема).Равно("Счет на оплату № 123 от 20.10.2026");
	ЮТест.ОжидаетЧто(ПараметрыОтправки.Текст, "Текст письма").Равно("Текст КА");

КонецПроцедуры

Процедура ПередОтправкойПоПочте_НесколькоСчетов() Экспорт

	Счет2 = НовыйСчет("ТЕ00-000002", Дата(2026, 10, 21));
	Счет1 = НовыйСчет("ТЕ00-000001", Дата(2026, 10, 20));

	ПараметрыОтправки = ВызватьПередОтправкойПоПочте(ОбъектыПечати(Счет2, Счет1, Счет2));

	ЮТест.ОжидаетЧто(ПараметрыОтправки.Тема).Равно("Счет на оплату № 1 от 20.10.2026, № 2 от 21.10.2026");

КонецПроцедуры

Процедура ПередОтправкойПоПочте_НеСчет() Экспорт

	ПараметрыОтправки = ВызватьПередОтправкойПоПочте(ОбъектыПечати(ДругойДокумент()));

	ЮТест.ОжидаетЧто(ПараметрыОтправки.Тема).Равно("Документы");

КонецПроцедуры

Процедура ПередОтправкойПоПочте_СчетИДругойДокумент() Экспорт

	Счет = НовыйСчет("ТЕ00-000123", Дата(2026, 10, 20));

	ПараметрыОтправки = ВызватьПередОтправкойПоПочте(ОбъектыПечати(Счет, ДругойДокумент()));

	ЮТест.ОжидаетЧто(ПараметрыОтправки.Тема).Равно("Документы");

КонецПроцедуры

Процедура ПередОтправкойПоПочте_СчётНеНайден() Экспорт

	Счет = НовыйСчет("ТЕ00-000123", Дата(2026, 10, 20));
	НеНайденныйСчет = Документы.СчетНаОплатуКлиенту.ПолучитьСсылку(Новый УникальныйИдентификатор);

	ПараметрыОтправки = ВызватьПередОтправкойПоПочте(ОбъектыПечати(Счет, НеНайденныйСчет));

	ЮТест.ОжидаетЧто(ПараметрыОтправки.Тема, "Счёт и несуществующий счёт").Равно("Документы");

	ПараметрыОтправки = ВызватьПередОтправкойПоПочте(ОбъектыПечати(НеНайденныйСчет));

	ЮТест.ОжидаетЧто(ПараметрыОтправки.Тема, "Только несуществующий счёт").Равно("Документы");

КонецПроцедуры

Процедура ПередОтправкойПоПочте_НетОбъектов() Экспорт

	ЮТест.ОжидаетЧто(ВызватьПередОтправкойПоПочте(Неопределено).Тема, "Неопределено").Равно("Документы");
	ЮТест.ОжидаетЧто(ВызватьПередОтправкойПоПочте(Новый Массив).Тема, "Пустой массив").Равно("Документы");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеСчета(Номер, Дата)
	Возврат Новый Структура("Номер, Дата", Номер, Дата);
КонецФункции

// Счёт для тестов в транзакции с откатом: пишется с ОбменДанными.Загрузка, заполнение и проведение не нужны.
Функция НовыйСчет(Номер, Дата)
	СчетОбъект = Документы.СчетНаОплатуКлиенту.СоздатьДокумент();
	СчетОбъект.Номер = Номер;
	СчетОбъект.Дата = Дата;
	СчетОбъект.ОбменДанными.Загрузка = Истина;
	СчетОбъект.Записать();
	Возврат СчетОбъект.Ссылка;
КонецФункции

// Документ, не являющийся счётом на оплату: письмо с несуществующей учётной записью, в транзакции с откатом.
Функция ДругойДокумент()
	ПисьмоОбъект = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	ПисьмоОбъект.Дата = ТекущаяДатаСеанса();
	ПисьмоОбъект.Тема = "мопТ: тестовое письмо";
	ПисьмоОбъект.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ПисьмоОбъект.ОбменДанными.Загрузка = Истина;
	ПисьмоОбъект.Записать();
	Возврат ПисьмоОбъект.Ссылка;
КонецФункции

Функция ОбъектыПечати(Объект1, Объект2 = Неопределено, Объект3 = Неопределено)
	Результат = Новый Массив;
	Результат.Добавить(Объект1);
	Если Объект2 <> Неопределено Тогда
		Результат.Добавить(Объект2);
	КонецЕсли;
	Если Объект3 <> Неопределено Тогда
		Результат.Добавить(Объект3);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Вызывает точку расширения БСП, как форма печати документов: параметры письма с темой «Документы», которую поставила КА.
Функция ВызватьПередОтправкойПоПочте(ОбъектыПечати)
	ПараметрыОтправки = Новый Структура("Получатель, Тема, Текст", Неопределено, "Документы", "Текст КА");
	УправлениеПечатьюПереопределяемый.ПередОтправкойПоПочте(ПараметрыОтправки, Неопределено, ОбъектыПечати, Неопределено);
	Возврат ПараметрыОтправки;
КонецФункции

#КонецОбласти
