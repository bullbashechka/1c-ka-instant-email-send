#Область СлужебныеПроцедурыИФункции

Функция ДанныеСчета(Номер, Дата)
	Возврат Новый Структура("Номер, Дата", Номер, Дата);
КонецФункции

// Счёт для тестов в транзакции с откатом: пишется с ОбменДанными.Загрузка, заполнение и проведение не нужны.
Функция НовыйСчет(Номер, Дата)
	СчетОбъект = Документы.СчетНаОплатуКлиенту.СоздатьДокумент();
	СчетОбъект.Номер = Номер;
	СчетОбъект.Дата = Дата;
	СчетОбъект.ОбменДанными.Загрузка = Истина;
	СчетОбъект.Записать();
	Возврат СчетОбъект.Ссылка;
КонецФункции

// Заказ клиента для тестов в транзакции с откатом: пишется с ОбменДанными.Загрузка, заполнение и проведение не нужны.
Функция НовыйЗаказ(Номер, Дата)
	ЗаказОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
	ЗаказОбъект.Номер = Номер;
	ЗаказОбъект.Дата = Дата;
	ЗаказОбъект.ОбменДанными.Загрузка = Истина;
	ЗаказОбъект.Записать();
	Возврат ЗаказОбъект.Ссылка;
КонецФункции

// Метка, которой типовая КА и форма ГЕМ помечают печатную форму счёта на оплату.
Функция МеткаФормыСчета()
	Возврат "ПАРАМЕТРЫ_ПЕЧАТИ_СЧЕТНАОПЛАТУ";
КонецФункции

// Печатные формы письма, как их передаёт форма печати документов: Название и ТабличныйДокумент с меткой формы.
Функция ПечатныеФормы(Метка1 = Неопределено, Метка2 = Неопределено)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Название");
	Результат.Колонки.Добавить("ТабличныйДокумент");
	Метки = Новый Массив;
	Если Метка1 <> Неопределено Тогда Метки.Добавить(Метка1); КонецЕсли;
	Если Метка2 <> Неопределено Тогда Метки.Добавить(Метка2); КонецЕсли;
	Для Каждого Метка Из Метки Цикл
		СтрокаФормы = Результат.Добавить();
		СтрокаФормы.Название = "Печатная форма " + Метка;
		СтрокаФормы.ТабличныйДокумент = Новый ТабличныйДокумент;
		СтрокаФормы.ТабличныйДокумент.ИмяПараметровПечати = Метка;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Документ, не являющийся счётом на оплату: письмо с несуществующей учётной записью, в транзакции с откатом.
Функция ДругойДокумент()
	ПисьмоОбъект = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент();
	ПисьмоОбъект.Дата = ТекущаяДатаСеанса();
	ПисьмоОбъект.Тема = "мопТ: тестовое письмо";
	ПисьмоОбъект.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ПисьмоОбъект.ОбменДанными.Загрузка = Истина;
	ПисьмоОбъект.Записать();
	Возврат ПисьмоОбъект.Ссылка;
КонецФункции

Функция ОбъектыПечати(Объект1, Объект2 = Неопределено, Объект3 = Неопределено)
	Результат = Новый Массив;
	Результат.Добавить(Объект1);
	Если Объект2 <> Неопределено Тогда
		Результат.Добавить(Объект2);
	КонецЕсли;
	Если Объект3 <> Неопределено Тогда
		Результат.Добавить(Объект3);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Вызывает точку расширения БСП, как форма печати документов: параметры письма с темой «Документы», которую поставила КА.
Функция ВызватьПередОтправкойПоПочте(ОбъектыПечати, ПечатныеФормы = Неопределено)
	ПараметрыОтправки = Новый Структура("Получатель, Тема, Текст", Неопределено, "Документы", "Текст КА");
	УправлениеПечатьюПереопределяемый.ПередОтправкойПоПочте(ПараметрыОтправки, Неопределено, ОбъектыПечати, ПечатныеФормы);
	Возврат ПараметрыОтправки;
КонецФункции

#КонецОбласти
