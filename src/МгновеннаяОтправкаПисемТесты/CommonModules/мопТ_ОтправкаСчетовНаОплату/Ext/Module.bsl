Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ТемаПисьмаСчетов_ОдинСчет",
			"Один счёт: номер без префиксов и ведущих нулей, дата в коротком формате")
		.ДобавитьСерверныйТест("ТемаПисьмаСчетов_НесколькоСчетов",
			"Несколько счетов: по дате, затем по номеру, одинаковые не повторяются")

		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_Счет",
			"Счёт заменяет тему «Документы» на «Счет на оплату № … от …»").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_НесколькоСчетов",
			"Несколько счетов в письме перечислены в теме по дате").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_НеСчет",
			"Печатная форма другого документа тему не меняет").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_СчетИДругойДокумент",
			"Счёт вместе с другим документом тему не меняет").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_СчётНеНайден",
			"Несуществующий счёт тему не меняет и ошибки не даёт").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_НетОбъектов",
			"Без объектов печати тема не меняется")

		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_ЗаказСФормойСчета",
			"Форма счёта, напечатанная из заказа клиента, ставит тему с номером и датой заказа").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_МеткаБезУчетаРегистра",
			"Метка формы счёта узнаётся независимо от регистра букв").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_НесколькоЗаказов",
			"Несколько заказов с формой счёта перечислены в теме по дате, одинаковые не повторяются").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_СчетИЗаказ",
			"Счёт вместе с заказом, форма счёта: оба в теме по дате").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_ЗаказСДругойФормой",
			"Форма счёта вместе с другой печатной формой заказа тему не меняет").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_ЗаказСФормойИзвещения",
			"Печатная форма «Извещение» из заказа тему не меняет").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_ЗаказБезФорм",
			"Заказ без печатных форм тему не меняет").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_ЗаказНеНайден",
			"Несуществующий заказ с формой счёта тему не меняет и ошибки не даёт").ВТранзакции()
		.ДобавитьСерверныйТест("ПередОтправкойПоПочте_СчетСДругойФормой",
			"Для счёта тема с номером не зависит от метки печатной формы").ВТранзакции();

