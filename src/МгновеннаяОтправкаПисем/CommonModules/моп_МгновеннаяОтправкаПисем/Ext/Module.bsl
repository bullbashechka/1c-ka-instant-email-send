#Область ПрограммныйИнтерфейс

#Область ПравилаБезОбращенияКБазе

// Правила доступности мгновенной отправки (Ф4, Ф5, Ф6). К базе не обращается.
//
// Параметры:
//  СтатусПисьма - ПеречислениеСсылка.СтатусыИсходящегоЭлектронногоПисьма
//  ДатаКогдаОтправить - Дата - поле «Когда отправить».
//  ДатаАктуальностиОтправки - Дата - поле «Не отправлять после».
//  ВнешниеРесурсыЗаблокированы - Булево - работа с внешними ресурсами заблокирована БСП.
//  ТекущаяДата - Дата - текущая дата сеанса.
//
// Возвращаемое значение:
//  Структура:
//   * Доступна - Булево
//   * ТекстОтказа - Строка - причина для пользователя; пустая, если сообщать нечего.
//
Функция ДоступностьОтправки(СтатусПисьма, ДатаКогдаОтправить, ДатаАктуальностиОтправки,
	ВнешниеРесурсыЗаблокированы, ТекущаяДата) Экспорт
	
	Результат = Новый Структура("Доступна, ТекстОтказа", Ложь, "");
	Черновик = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Черновик;
	
	Если ВнешниеРесурсыЗаблокированы Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Письмо не отправлено: работа с внешними ресурсами заблокирована'");
	ИначеЕсли ЗначениеЗаполнено(ДатаАктуальностиОтправки) И ДатаАктуальностиОтправки <= ТекущаяДата Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Письмо не отправлено: истёк срок, указанный в поле «Не отправлять после»'");
	ИначеЕсли СтатусПисьма = Черновик И ЗначениеЗаполнено(ДатаКогдаОтправить) И ДатаКогдаОтправить >= ТекущаяДата Тогда
		// Обычная отложенная отправка: письмо отправит регламентное задание.
	ИначеЕсли СтатусПисьма = Черновик
		Или СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее Тогда
		Результат.Доступна = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Пауза перед попыткой отправки (Ф2).
//
// Параметры:
//  НомерПопытки - Число - номер попытки, начиная с 1.
//
// Возвращаемое значение:
//  Число - пауза в секундах.
//
Функция ПаузаПередПопыткой(НомерПопытки) Экспорт

	Если НомерПопытки = 2 Тогда
		Возврат 10;
	ИначеЕсли НомерПопытки = 3 Тогда
		Возврат 30;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Возвращаемое значение:
//  Число - сколько попыток делает мгновенная отправка (Ф2).
//
Функция КоличествоПопыток() Экспорт

	Возврат 3;

КонецФункции

// Служебное значение «Когда отправить» на время мгновенной отправки (Ф7):
// регламентное задание и «Отправить и получить почту» такие письма не берут.
//
// Параметры:
//  ТекущаяДата - Дата
//
// Возвращаемое значение:
//  Дата
//
Функция ДатаСкрытияОтРегламентногоЗадания(ТекущаяДата) Экспорт
	
	Возврат ТекущаяДата + 10 * 60;
	
КонецФункции

// Параметры:
//  ДатаКогдаОтправить - Дата - текущее служебное значение «Когда отправить».
//  ТекущаяДата - Дата
//
// Возвращаемое значение:
//  Булево - Истина, если до служебного значения осталось меньше 5 минут.
//
Функция НужноПродлитьСкрытие(ДатаКогдаОтправить, ТекущаяДата) Экспорт
	
	Возврат ДатаКогдаОтправить - ТекущаяДата < 5 * 60;
	
КонецФункции

// Действует ли запись регистра ЗаблокированныеДляПолученияУчетныеЗаписи (Ф2, Ф7).
//
// Параметры:
//  ДатаБлокировки - Дата, Неопределено - дата из записи регистра; Неопределено, если записи нет.
//  ТекущаяДата - Дата
//  ВладелецАктивен - Булево - жив ли процесс, который мог поставить блокировку.
//
// Возвращаемое значение:
//  Булево
//
Функция БлокировкаДействует(ДатаБлокировки, ТекущаяДата, ВладелецАктивен) Экспорт
	
	Возврат ЗначениеЗаполнено(ДатаБлокировки)
		И ДатаБлокировки + 60 * 60 > ТекущаяДата
		И ВладелецАктивен;
	
КонецФункции

// Параметры:
//  ИдентификаторУчетнойЗаписи - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Строка - наименование фонового задания мгновенной отправки с этой учётной записи.
//
Функция НаименованиеЗаданияОтправки(ИдентификаторУчетнойЗаписи) Экспорт
	
	Возврат СтрШаблон(НСтр("ru = 'Мгновенная отправка письма (%1)'"), ИдентификаторУчетнойЗаписи);
	
КонецФункции

// Параметры:
//  Наименование - Строка - наименование фонового задания.
//  ИдентификаторУчетнойЗаписи - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Булево - Истина, если это мгновенная отправка с этой учётной записи.
//
Функция ЭтоЗаданиеОтправкиУчетнойЗаписи(Наименование, ИдентификаторУчетнойЗаписи) Экспорт
	
	Возврат Наименование = НаименованиеЗаданияОтправки(ИдентификаторУчетнойЗаписи);
	
КонецФункции

// Могло ли задание, начатое в НачалоЗадания, взять письмо в свою выборку до того, как оно было скрыто.
//
// Параметры:
//  НачалоЗадания - Дата - начало фонового задания по времени сервера.
//  МоментСкрытия - Дата - когда письмо скрыто, по времени сервера.
//
// Возвращаемое значение:
//  Булево
//
Функция ЗаданиеМоглоВзятьПисьмо(НачалоЗадания, МоментСкрытия) Экспорт
	
	Возврат НачалоЗадания <= МоментСкрытия;
	
КонецФункции

// Считается ли другая мгновенная отправка с той же учётной записью владельцем блокировки:
// только если она началась раньше текущей. Иначе ожидающие отправки блокировали бы друг друга.
//
// Параметры:
//  НачалоДругого - Дата
//  НачалоТекущего - Дата
//
// Возвращаемое значение:
//  Булево
//
Функция ДругоеЗаданиеДержитБлокировку(НачалоДругого, НачалоТекущего) Экспорт
	
	Возврат НачалоДругого < НачалоТекущего;
	
КонецФункции

#КонецОбласти

#Область БлокировкаУчетнойЗаписи

// Занимает учётную запись для мгновенной отправки (Ф2, Ф7). Правило 60 минут то же, что в
// УправлениеЭлектроннойПочтой.ЗаблокироватьУчетнуюЗапись, но молодая запись регистра действует,
// только пока жив её возможный владелец.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиЭлектроннойПочты
//  ВладелецАктивен - Булево, Неопределено - жив ли владелец существующей записи;
//                    Неопределено - определить через ВладелецБлокировкиАктивен.
//
// Возвращаемое значение:
//  Дата - записанная ДатаБлокировки, если учётная запись занята этой отправкой;
//  Неопределено - учётная запись занята другим процессом.
//
Функция ЗахватитьУчетнуюЗапись(УчетнаяЗапись, ВладелецАктивен = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗаблокированныеДляПолученияУчетныеЗаписи");
		ЭлементБлокировки.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись);
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = РегистрыСведений.ЗаблокированныеДляПолученияУчетныеЗаписи.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗапись;
		МенеджерЗаписи.Прочитать();
		
		ТекущаяДата = ТекущаяДатаСеанса();
		ДатаБлокировки = ?(МенеджерЗаписи.Выбран(), МенеджерЗаписи.ДатаБлокировки, Неопределено);
		Владелец = ВладелецАктивен;
		Если Владелец = Неопределено Тогда
			Владелец = БлокировкаДействует(ДатаБлокировки, ТекущаяДата, Истина)
				И ВладелецБлокировкиАктивен(УчетнаяЗапись);
		КонецЕсли;
		
		Если БлокировкаДействует(ДатаБлокировки, ТекущаяДата, Владелец) Тогда
			ЗафиксироватьТранзакцию();
			Возврат Неопределено;
		КонецЕсли;
		
		МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗапись;
		МенеджерЗаписи.ДатаБлокировки = ТекущаяДата;
		МенеджерЗаписи.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ТекущаяДата;
	
КонецФункции

// Освобождает учётную запись, только если её блокировка всё ещё принадлежит этой отправке.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиЭлектроннойПочты
//  ДатаБлокировки - Дата - значение, которое вернула ЗахватитьУчетнуюЗапись.
//
Процедура ОсвободитьУчетнуюЗапись(УчетнаяЗапись, ДатаБлокировки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗаблокированныеДляПолученияУчетныеЗаписи");
		ЭлементБлокировки.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись);
		Блокировка.Заблокировать();
		
		МенеджерЗаписи = РегистрыСведений.ЗаблокированныеДляПолученияУчетныеЗаписи.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УчетнаяЗапись = УчетнаяЗапись;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.ДатаБлокировки = ДатаБлокировки Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаписиПисьма

// Удаляет запись регистра НепринятыеКОбработкеПочтовымСерверомИсходящиеПисьма по письму (Ф4).
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//
Процедура СнятьОтказРегламентногоЗадания(Письмо) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.НепринятыеКОбработкеПочтовымСерверомИсходящиеПисьма.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Письмо.Установить(Письмо);
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Скрывает «Исходящее» письмо от регламентного задания на время мгновенной отправки (Ф7)
// и записывает ответ на вопрос о сохранении (Ф4).
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//  УдалятьПослеОтправки - Булево
//
// Возвращаемое значение:
//  Дата - момент скрытия по времени сервера;
//  Неопределено - письмо не «Исходящее» или удалено.
//
Функция СкрытьПисьмоОтРегламентногоЗадания(Письмо, УдалятьПослеОтправки) Экспорт
	
	Параметры = Новый Структура("УдалятьПослеОтправки", УдалятьПослеОтправки);
	Если Не ИзменитьПисьмо(Письмо, "Скрыть", Параметры) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Время сервера, как у ФоновоеЗадание.Начало, с которым его сравнивают. Берётся после фиксации записи:
	// задание, начатое позже, уже видит письмо скрытым.
	Возврат ТекущаяДата();
	
КонецФункции

// Продлевает служебное «Когда отправить» у «Исходящего» письма.
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//
Процедура ПродлитьСкрытие(Письмо) Экспорт
	
	ИзменитьПисьмо(Письмо, "Продлить");

КонецПроцедуры

// Продлевает скрытие «Исходящего» письма, если до служебного «Когда отправить» осталось меньше 5 минут (Ф7).
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//
// Возвращаемое значение:
//  Булево - Истина, если скрытие продлено.
//
Функция ПродлитьСкрытиеПриНеобходимости(Письмо) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Письмо, "СтатусПисьма, ДатаКогдаОтправить");
	Если Реквизиты.СтатусПисьма <> Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее
		Или Не НужноПродлитьСкрытие(Реквизиты.ДатаКогдаОтправить, ТекущаяДатаСеанса()) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПродлитьСкрытие(Письмо);
	Возврат Истина;

КонецФункции

// Очищает «Когда отправить» у «Исходящего» письма, чтобы его отправило регламентное задание.
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//
Процедура ВернутьПисьмоРегламентномуЗаданию(Письмо) Экспорт
	
	ИзменитьПисьмо(Письмо, "ВернутьРегламентномуЗаданию");
	
КонецПроцедуры

// Возвращает письмо в черновики (Ф2): статус «Черновик», пустое «Когда отправить» и выключенное
// «Включать текст исходного письма» одной записью. Папка — как у типового черновика, без правил обработки почты.
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//
Процедура ВернутьВЧерновики(Письмо) Экспорт

	Если ИзменитьПисьмо(Письмо, "ВернутьВЧерновики") Тогда
		УстановитьПапкуПисьма(Письмо, Истина);
	КонецЕсли;

КонецПроцедуры

// Записывает результат успешной отправки (Ф1): удаляет письмо или переводит его в «Отправленные».
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//  ИдентификаторСообщения - Строка - идентификатор письма SMTP.
//  ИдентификаторСообщенияОтправкаIMAP - Строка
//  ДатаОтправления - Дата, Неопределено - когда почтовый сервер принял письмо; Неопределено - текущая дата сеанса.
//
// Возвращаемое значение:
//  Булево - Истина, если письмо удалено (учётная запись без сохранения отправленных писем).
//
Функция ЗаписатьРезультатОтправки(Письмо, ИдентификаторСообщения, ИдентификаторСообщенияОтправкаIMAP,
	ДатаОтправления = Неопределено) Экспорт

	Параметры = Новый Структура("ИдентификаторСообщения, ИдентификаторСообщенияОтправкаIMAP, ДатаОтправления, ПисьмоУдалено",
		ИдентификаторСообщения, ИдентификаторСообщенияОтправкаIMAP,
		?(ДатаОтправления = Неопределено, ТекущаяДатаСеанса(), ДатаОтправления), Истина);
	// Письмо уже ушло: ждём до 2 минут, пока его закроют, если оно открыто на редактирование (Ф2).
	Записано = ИзменитьПисьмо(Письмо, "ЗаписатьРезультат", Параметры, 120);
	Если Записано И Не Параметры.ПисьмоУдалено Тогда
		УстановитьПапкуПисьма(Письмо);
	КонецЕсли;

	Возврат Параметры.ПисьмоУдалено;
	
КонецФункции

#КонецОбласти

#Область Отправка

// Возвращаемое значение:
//  Булево - работа с внешними ресурсами заблокирована БСП (Ф6).
//
Функция ВнешниеРесурсыЗаблокированы() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована();
	
КонецФункции

// Доступность мгновенной отправки письма сейчас (Ф4, Ф5, Ф6).
//
// Параметры:
//  СтатусПисьма - ПеречислениеСсылка.СтатусыИсходящегоЭлектронногоПисьма
//  ДатаКогдаОтправить - Дата
//  ДатаАктуальностиОтправки - Дата
//
// Возвращаемое значение:
//  см. ДоступностьОтправки
//
Функция ПроверитьДоступностьОтправки(СтатусПисьма, ДатаКогдаОтправить, ДатаАктуальностиОтправки) Экспорт
	
	Возврат ДоступностьОтправки(СтатусПисьма, ДатаКогдаОтправить, ДатаАктуальностиОтправки,
		ВнешниеРесурсыЗаблокированы(), ТекущаяДатаСеанса());
	
КонецФункции

// Запускает фоновую мгновенную отправку письма (Ф1, Ф4, Ф7).
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//  УдалятьПослеОтправки - Булево - ответ на типовой вопрос о сохранении.
//  БылоИсходящим - Булево - письмо до нажатия уже лежало в «Исходящих».
//
// Возвращаемое значение:
//  Структура:
//   * УжеОтправляется - Булево
//   * ДлительнаяОперация - см. ДлительныеОперации.ВыполнитьВФоне
//
Функция НачатьОтправку(Письмо, УдалятьПослеОтправки, БылоИсходящим) Экспорт
	
	Результат = Новый Структура("УжеОтправляется, ДлительнаяОперация", Ложь, Неопределено);
	
	КлючЗадания = "моп_ОтправкаПисьма_" + Письмо.УникальныйИдентификатор();
	Если ОтправкаВыполняется(КлючЗадания) Тогда
		Результат.УжеОтправляется = Истина;
		Возврат Результат;
	КонецЕсли;
	
	СнятьОтказРегламентногоЗадания(Письмо);
	
	МоментСкрытия = Неопределено;
	Если БылоИсходящим Тогда
		МоментСкрытия = СкрытьПисьмоОтРегламентногоЗадания(Письмо, УдалятьПослеОтправки);
	КонецЕсли;
	
	УчетнаяЗапись = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Письмо, "УчетнаяЗапись");
	ПараметрыОтправки = Новый Структура("Письмо, УчетнаяЗапись, МоментСкрытия", Письмо, УчетнаяЗапись, МоментСкрытия);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Неопределено);
	ПараметрыВыполнения.КлючФоновогоЗадания = КлючЗадания;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗаданияОтправки(УчетнаяЗапись.УникальныйИдентификатор());
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне("моп_МгновеннаяОтправкаПисем.ОтправитьПисьмоВФоне",
		ПараметрыОтправки, ПараметрыВыполнения);
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		// Другой пользователь мог запустить отправку того же письма между проверкой и запуском.
		Если ОтправкаВыполняется(КлючЗадания) Тогда
			УдалитьИзВременногоХранилища(ПараметрыВыполнения.АдресРезультата);
			Результат.УжеОтправляется = Истина;
			Возврат Результат;
		КонецЕсли;
		ВернутьПисьмоРегламентномуЗаданию(Письмо);
	КонецЕсли;
	
	Результат.ДлительнаяОперация = ДлительнаяОперация;
	Возврат Результат;
	
КонецФункции

// Процедура фонового задания мгновенной отправки.
//
// Параметры:
//  Параметры - Структура - Письмо, УчетнаяЗапись, МоментСкрытия: см. ВыполнитьОтправку.
//  АдресРезультата - Строка - сюда помещается результат ВыполнитьОтправку.
//
Процедура ОтправитьПисьмоВФоне(Параметры, АдресРезультата) Экспорт
	
	Попытка
		Результат = ВыполнитьОтправку(Параметры.Письмо, Параметры.УчетнаяЗапись, Параметры.МоментСкрытия);
	Исключение
		ЗаписатьОшибку(Параметры.Письмо, 0, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

// Отправляет письмо до трёх попыток (Ф2, Ф7). Вне фонового задания не ждёт.
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиЭлектроннойПочты - учётная запись на момент запуска.
//  МоментСкрытия - Дата, Неопределено - когда скрыто письмо, которое уже было «Исходящим»;
//                  Неопределено - письмо скрыто при переходе из черновика.
//
// Возвращаемое значение:
//  Структура:
//   * Итог - Строка - Отправлено, ОтправленоЧастично, НеОтправлено, ВозвращеноВЧерновики, Прекращено.
//   * ТекстСообщения - Строка
//   * Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//   * Тема - Строка
//   * УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиЭлектроннойПочты
//   * ПисьмоУдалено - Булево
//   * ПисьмоПринятоСервером - Булево - почтовый сервер принял письмо от этой отправки.
//   * ОшибкаПодключения - Булево - письмо не отправлено из-за ошибки почтового сервера: не ответил,
//                         не принял логин, пароль, порт или шифрование.
//
Функция ВыполнитьОтправку(Письмо, УчетнаяЗапись, МоментСкрытия) Экспорт

	Результат = НовыйРезультатОтправки(Письмо, УчетнаяЗапись);

	Попытка
		ОтправитьСПопытками(Письмо, УчетнаяЗапись, МоментСкрытия, Результат);
	Исключение
		// Письмо не ушло: не держать его скрытым от регламентного задания до 10 минут.
		Если Не Результат.ПисьмоПринятоСервером Тогда
			ИзменитьПисьмоБезОшибок(Письмо, "ВернутьРегламентномуЗаданию", 0);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область АктивныеФоновыеЗадания

// Жив ли процесс, который мог поставить блокировку учётной записи: регламентное задание,
// «Отправить и получить почту» или мгновенная отправка с этой учётной записью, начатая раньше текущей.
// В файловой базе фоновые задания других клиентов не видны, поэтому блокировка всегда считается живой.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиЭлектроннойПочты
//
// Возвращаемое значение:
//  Булево
//
Функция ВладелецБлокировкиАктивен(УчетнаяЗапись) Экспорт

	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		Возврат Истина;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Если АктивныеЗаданияПолученияПочты().Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Наименование = НаименованиеЗаданияОтправки(УчетнаяЗапись.УникальныйИдентификатор());
	Отбор = Новый Структура("Наименование, Состояние", Наименование, СостояниеФоновогоЗадания.Активно);
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Если ТекущееЗадание = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Если Задание.УникальныйИдентификатор <> ТекущееЗадание.УникальныйИдентификатор
			И ДругоеЗаданиеДержитБлокировку(Задание.Начало, ТекущееЗадание.Начало) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Активны ли регламентное задание или «Отправить и получить почту», начатые до скрытия письма:
// только они могли взять письмо в свою выборку (Ф7).
//
// Параметры:
//  МоментСкрытия - Дата - время сервера, когда письмо скрыто.
//
// Возвращаемое значение:
//  Булево
//
Функция ЗаданияМоглиВзятьПисьмо(МоментСкрытия) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Для Каждого Задание Из АктивныеЗаданияПолученияПочты() Цикл
		Если ЗаданиеМоглоВзятьПисьмо(Задание.Начало, МоментСкрытия) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// До трёх попыток отправки с паузами и ожиданием учётной записи (Ф2, Ф7). Вне фонового задания не ждёт.
// Параметры и результат - см. ВыполнитьОтправку.
Процедура ОтправитьСПопытками(Письмо, УчетнаяЗапись, МоментСкрытия, Результат)

	ВФоновомЗадании = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() <> Неопределено;
	ПределОжидания = 5 * 60;
	ИнтервалОжидания = 5;
	Ожидание = 0;
	ОшибкаЗахватаЗаписана = Ложь;

	Для НомерПопытки = 1 По КоличествоПопыток() Цикл

		Пауза(ПаузаПередПопыткой(НомерПопытки));

		ДатаБлокировки = Неопределено;
		Пока Истина Цикл
			Если МоментСкрытия = Неопределено Или Не ЗаданияМоглиВзятьПисьмо(МоментСкрытия) Тогда
				Попытка
					ДатаБлокировки = ЗахватитьУчетнуюЗапись(УчетнаяЗапись);
				Исключение
					// Конфликт блокировок регистра: учётная запись считается занятой.
					Если Не ОшибкаЗахватаЗаписана Тогда
						ЗаписатьОшибку(Письмо, НомерПопытки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						ОшибкаЗахватаЗаписана = Истина;
					КонецЕсли;
				КонецПопытки;
				Если ДатаБлокировки <> Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			Если Не ВФоновомЗадании Или Ожидание >= ПределОжидания Тогда
				ЗавершитьОжиданиеУчетнойЗаписи(Письмо, УчетнаяЗапись, НомерПопытки, Результат);
				Возврат;
			КонецЕсли;
			// Пока учётная запись занята, письмо должно оставаться скрытым от регламентного задания.
			ПродлитьСкрытиеБезОшибок(Письмо, НомерПопытки);
			Пауза(ИнтервалОжидания);
			Ожидание = Ожидание + ИнтервалОжидания;
		КонецЦикла;

		Попытка
			ПопыткаЗавершена = ВыполнитьПопытку(Письмо, УчетнаяЗапись, НомерПопытки, Результат);
		Исключение
			ОсвободитьУчетнуюЗапись(УчетнаяЗапись, ДатаБлокировки);
			ВызватьИсключение;
		КонецПопытки;
		ОсвободитьУчетнуюЗапись(УчетнаяЗапись, ДатаБлокировки);

		Если ПопыткаЗавершена Тогда
			Если Результат.Итог = "НеОтправлено" Или Результат.Итог = "Прекращено" Тогда
				ИзменитьПисьмоБезОшибок(Письмо, "ВернутьРегламентномуЗаданию", НомерПопытки);
			КонецЕсли;
			Возврат;
		КонецЕсли;

	КонецЦикла;

	// Все попытки не удались из-за соединения: письмо отправит регламентное задание.
	ИзменитьПисьмоБезОшибок(Письмо, "ВернутьРегламентномуЗаданию", КоличествоПопыток());

КонецПроцедуры

// Применяет к письму одно изменение из фоновой отправки: в транзакции с управляемой блокировкой
// и с объектной блокировкой, чтобы не затереть правку пользователя в открытой форме.
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//  Действие - Строка - Скрыть, Продлить, ВернутьРегламентномуЗаданию, ВернутьВЧерновики, ЗаписатьРезультат.
//  Параметры - Структура - параметры и результаты действия.
//  КоличествоПовторов - Число - сколько раз через секунду пробовать занять письмо, открытое на редактирование.
//
// Возвращаемое значение:
//  Булево - Истина, если письмо записано или удалено.
//
Функция ИзменитьПисьмо(Письмо, Действие, Параметры = Неопределено, КоличествоПовторов = 10)

	Если Не ОбщегоНазначения.СсылкаСуществует(Письмо) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаблокироватьПисьмоДляРедактирования(Письмо, КоличествоПовторов);
	Попытка
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.ЭлектронноеПисьмоИсходящее");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Письмо);
			РегистрыСведений.ПредметыПапкиВзаимодействий.ЗаблокироватьПредметыПапокВзаимодействий(Блокировка, Письмо);
			Блокировка.Заблокировать();

			ПисьмоОбъект = Письмо.ПолучитьОбъект();
			Записано = ПисьмоОбъект <> Неопределено
				И ПрименитьДействие(ПисьмоОбъект, Действие, Параметры);

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		РазблокироватьДанныеДляРедактирования(Письмо);
		ВызватьИсключение;
	КонецПопытки;
	РазблокироватьДанныеДляРедактирования(Письмо);

	Возврат Записано;

КонецФункции

// Вспомогательная запись письма из фоновой отправки: её сбой пишется в журнал и не прерывает отправку.
// Если запись не удалась, письмо остаётся скрытым не дольше 10 минут.
Процедура ИзменитьПисьмоБезОшибок(Письмо, Действие, НомерПопытки)

	Попытка
		ИзменитьПисьмо(Письмо, Действие);
	Исключение
		ЗаписатьОшибку(Письмо, НомерПопытки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Возвращаемое значение:
//  Булево - Истина, если скрытие продлено.
Функция ПродлитьСкрытиеБезОшибок(Письмо, НомерПопытки)

	Попытка
		Возврат ПродлитьСкрытиеПриНеобходимости(Письмо);
	Исключение
		ЗаписатьОшибку(Письмо, НомерПопытки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Ложь;

КонецФункции

Функция ПрименитьДействие(ПисьмоОбъект, Действие, Параметры)

	Исходящее = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее;
	ПисьмоОбъект.ДополнительныеСвойства.Вставить("НеЗаписыватьКонтакты", Истина);

	Если Действие = "Скрыть" Тогда
		Если ПисьмоОбъект.СтатусПисьма <> Исходящее Тогда
			Возврат Ложь;
		КонецЕсли;
		ПисьмоОбъект.ДатаКогдаОтправить = ДатаСкрытияОтРегламентногоЗадания(ТекущаяДатаСеанса());
		ПисьмоОбъект.УдалятьПослеОтправки = Параметры.УдалятьПослеОтправки;
		ПисьмоОбъект.Записать(РежимЗаписиДокумента.Запись);

	ИначеЕсли Действие = "Продлить" Тогда
		Если ПисьмоОбъект.СтатусПисьма <> Исходящее Тогда
			Возврат Ложь;
		КонецЕсли;
		ПисьмоОбъект.ДатаКогдаОтправить = ДатаСкрытияОтРегламентногоЗадания(ТекущаяДатаСеанса());
		ПисьмоОбъект.Записать(РежимЗаписиДокумента.Запись);

	ИначеЕсли Действие = "ВернутьРегламентномуЗаданию" Тогда
		Если ПисьмоОбъект.СтатусПисьма <> Исходящее Или Не ЗначениеЗаполнено(ПисьмоОбъект.ДатаКогдаОтправить) Тогда
			Возврат Ложь;
		КонецЕсли;
		ПисьмоОбъект.ДатаКогдаОтправить = Дата(1, 1, 1);
		ПисьмоОбъект.Записать(РежимЗаписиДокумента.Запись);

	ИначеЕсли Действие = "ВернутьВЧерновики" Тогда
		ПисьмоОбъект.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Черновик;
		ПисьмоОбъект.ДатаКогдаОтправить = Дата(1, 1, 1);
		// Цитата исходного письма уже в тексте: типовая запись при повторной «Отправить» добавила бы её ещё раз.
		ПисьмоОбъект.ВключатьТелоИсходногоПисьма = Ложь;
		ПисьмоОбъект.Записать(РежимЗаписиДокумента.Запись);

	ИначеЕсли Действие = "ЗаписатьРезультат" Тогда
		Если ПисьмоОбъект.УдалятьПослеОтправки Тогда
			// Права «Удаление» у менеджеров нет. Регламентное задание КА удаляет такие письма так же,
			// в привилегированном режиме (Ф9).
			УстановитьПривилегированныйРежим(Истина);
			ПисьмоОбъект.Удалить();
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Истина;
		КонецЕсли;
		ПисьмоОбъект.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Отправлено;
		ПисьмоОбъект.ДатаОтправления = Параметры.ДатаОтправления;
		ПисьмоОбъект.ИдентификаторСообщения = Параметры.ИдентификаторСообщения;
		ПисьмоОбъект.ИдентификаторСообщенияОтправкаIMAP = Параметры.ИдентификаторСообщенияОтправкаIMAP;
		ПисьмоОбъект.Размер = Взаимодействия.ОценитьРазмерИсходящегоЭлектронногоПисьма(ПисьмоОбъект.Ссылка);
		ПисьмоОбъект.ДатаКогдаОтправить = Дата(1, 1, 1);
		ПисьмоОбъект.Записать(РежимЗаписиДокумента.Запись);
		Параметры.ПисьмоУдалено = Ложь;

	Иначе
		ВызватьИсключение СтрШаблон("Неизвестное действие с письмом: %1", Действие);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Папка определяется после записи письма, отдельной транзакцией: ошибка в правилах обработки почты
// не должна отменять запись статуса (Ф1). Ошибка пишется в журнал регистрации.
// Черновику папку выбирают как типовая форма при смене статуса: без правил обработки почты.
Процедура УстановитьПапкуПисьма(Письмо, ЭтоЧерновик = Ложь)

	Попытка
		Если ЭтоЧерновик Тогда
			Папка = Взаимодействия.ОпределитьПапкуДляПисьмаПоУмолчанию(Письмо, Истина);
		Иначе
			Папка = Взаимодействия.ОпределитьПапкуДляПисьма(Письмо);
		КонецЕсли;
		НачатьТранзакцию();
		Попытка
			// Типовая ЗаписатьПредметыПапкиВзаимодействий читает и пишет регистр без своей блокировки.
			Блокировка = Новый БлокировкаДанных;
			РегистрыСведений.ПредметыПапкиВзаимодействий.ЗаблокироватьПредметыПапокВзаимодействий(Блокировка, Письмо);
			Блокировка.Заблокировать();
			Взаимодействия.УстановитьПапкуЭлектронногоПисьма(Письмо, Папка);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		Комментарий = СтрШаблон(НСтр("ru = 'Мгновенная отправка: не удалось установить папку письма: %1'",
			ОбщегоНазначения.КодОсновногоЯзыка()), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(УправлениеЭлектроннойПочтой.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЭлектронноеПисьмоИсходящее, Письмо, Комментарий);
	КонецПопытки;

КонецПроцедуры

// Объектная блокировка письма с повторами через секунду: пользователь мог открыть его на редактирование.
Процедура ЗаблокироватьПисьмоДляРедактирования(Письмо, КоличествоПовторов)

	Для НомерПовтора = 1 По КоличествоПовторов Цикл
		Попытка
			ЗаблокироватьДанныеДляРедактирования(Письмо);
			Возврат;
		Исключение
			Если НомерПовтора = КоличествоПовторов Тогда
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
		Пауза(1);
	КонецЦикла;

КонецПроцедуры

// Пауза внутри фонового задания. Вне фонового задания (режим отладки БСП, тесты) не ждёт.
Процедура Пауза(Секунд)

	Если Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;

	ТекущееЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ТекущееЗадание <> Неопределено Тогда
		ТекущееЗадание.ОжидатьЗавершенияВыполнения(Секунд);
	КонецЕсли;

КонецПроцедуры

// Активные фоновые задания типовой КА, которые получают и отправляют почту:
// регламентное задание и команда «Отправить и получить почту».
Функция АктивныеЗаданияПолученияПочты()

	Результат = Новый Массив;

	Отбор = Новый Структура("ИмяМетода, Состояние",
		Метаданные.РегламентныеЗадания.ПолучениеИОтправкаЭлектронныхПисем.ИмяМетода, СостояниеФоновогоЗадания.Активно);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор));

	// Наименование задания команды задаёт ВзаимодействияВызовСервера при запуске.
	Отбор = Новый Структура("Наименование, Состояние",
		НСтр("ru = 'Получение и отправка электронной почты пользователя'"), СостояниеФоновогоЗадания.Активно);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор));

	Возврат Результат;

КонецФункции

// Отправка дольше 5 минут ждала учётную запись (Ф2, Ф7). За это время письмо могли отправить,
// удалить или изменить, поэтому итог определяется по письму.
Процедура ЗавершитьОжиданиеУчетнойЗаписи(Письмо, УчетнаяЗапись, НомерПопытки, Результат)

	ПисьмоОбъект = ПисьмоДляПопытки(Письмо, УчетнаяЗапись, Результат);
	Если ПисьмоОбъект <> Неопределено Тогда
		Доступность = ПроверитьДоступностьОтправки(ПисьмоОбъект.СтатусПисьма,
			ПисьмоОбъект.ДатаКогдаОтправить, ПисьмоОбъект.ДатаАктуальностиОтправки);
		Результат.Итог = "НеОтправлено";
		Результат.ТекстСообщения = ?(Доступность.Доступна,
			НСтр("ru = 'Учетная запись занята получением или отправкой почты'"), Доступность.ТекстОтказа);
		ЗаписатьОшибку(Письмо, НомерПопытки, Результат.ТекстСообщения);
	КонецЕсли;
	ИзменитьПисьмоБезОшибок(Письмо, "ВернутьРегламентномуЗаданию", НомерПопытки);

КонецПроцедуры

// Проверки письма перед попыткой (Ф7): отправлено ли оно уже, не удалено ли, не стало ли черновиком,
// не сменилась ли учётная запись. Заполняет Тема, Итог и ОшибкаПодключения результата.
//
// Возвращаемое значение:
//  ДокументОбъект.ЭлектронноеПисьмоИсходящее - письмо можно отправлять;
//  Неопределено - итог окончательный: «Отправлено» или «Прекращено».
//
Функция ПисьмоДляПопытки(Письмо, УчетнаяЗапись, Результат)

	Результат.Итог = "Прекращено";
	Результат.ОшибкаПодключения = Ложь;
	ПисьмоОбъект = Письмо.ПолучитьОбъект();
	Если ПисьмоОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат.Тема = ПисьмоОбъект.Тема;
	Статусы = Перечисления.СтатусыИсходящегоЭлектронногоПисьма;
	Если ПисьмоОбъект.СтатусПисьма = Статусы.Отправлено Тогда
		Результат.Итог = "Отправлено";
		Возврат Неопределено;
	КонецЕсли;
	Если ПисьмоОбъект.ПометкаУдаления
		Или ПисьмоОбъект.СтатусПисьма <> Статусы.Исходящее
		Или ПисьмоОбъект.УчетнаяЗапись <> УчетнаяЗапись Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПисьмоОбъект;

КонецФункции

// Одна попытка отправки при занятой этой отправкой учётной записи.
//
// Возвращаемое значение:
//  Булево - Истина, если результат окончательный; Ложь - ошибка соединения, нужна следующая попытка.
//
Функция ВыполнитьПопытку(Письмо, УчетнаяЗапись, НомерПопытки, Результат)

	ПисьмоОбъект = ПисьмоДляПопытки(Письмо, УчетнаяЗапись, Результат);
	Если ПисьмоОбъект = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Доступность = ПроверитьДоступностьОтправки(ПисьмоОбъект.СтатусПисьма,
		ПисьмоОбъект.ДатаКогдаОтправить, ПисьмоОбъект.ДатаАктуальностиОтправки);
	Если Не Доступность.Доступна Тогда
		Результат.Итог = "НеОтправлено";
		Результат.ТекстСообщения = Доступность.ТекстОтказа;
		Возврат Истина;
	КонецЕсли;
	
	Если ПродлитьСкрытиеБезОшибок(Письмо, НомерПопытки) Тогда
		ПисьмоОбъект = Письмо.ПолучитьОбъект();
		Если ПисьмоОбъект = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Попытка
		ПараметрыПисьма = Взаимодействия.ПараметрыПисьмаДляОтправки(ПисьмоОбъект);
		ПочтовоеПисьмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписатьОшибку(Письмо, НомерПопытки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ВернутьВЧерновикиБезОшибок(Письмо, НомерПопытки);
		Результат.Итог = "ВозвращеноВЧерновики";
		Результат.ТекстСообщения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Возврат Истина;
	КонецПопытки;
	
	Попытка
		РезультатОтправки = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, ПочтовоеПисьмо);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписатьОшибку(Письмо, НомерПопытки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		Результат.Итог = "НеОтправлено";
		Результат.ТекстСообщения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Результат.ОшибкаПодключения = Истина;
		Возврат Ложь;
	КонецПопытки;

	ДатаОтправления = ТекущаяДатаСеанса();
	Результат.ПисьмоПринятоСервером = Истина;
	Результат.Итог = "Отправлено";
	Если ЗначениеЗаполнено(РезультатОтправки.ОшибочныеПолучатели) Тогда
		// Функция сама пишет в журнал регистрации и статус письма не меняет.
		ПараметрыОбработкиОшибки = УправлениеЭлектроннойПочтой.ПараметрыОбработкиОшибкиОтправки();
		ПараметрыОбработкиОшибки.ПисьмоОбъект = ПисьмоОбъект;
		ПараметрыОбработкиОшибки.Ссылка = Письмо;
		ПараметрыОбработкиОшибки.ПредставлениеПисьма = Взаимодействия.ПредставлениеПисьма(ПисьмоОбъект.Тема, ПисьмоОбъект.Дата);
		ПараметрыОбработкиОшибки.КоличествоПопыток = 0;
		ПараметрыОбработкиОшибки.ИнкрементироватьКоличествоПопыток = Ложь;
		ПараметрыОбработкиОшибки.СообщатьПользователю = Ложь;
		ОбработкаОшибки = УправлениеЭлектроннойПочтой.ОбработатьОшибкуОтправкиПисьма(
			ПараметрыОбработкиОшибки, РезультатОтправки.ОшибочныеПолучатели);
		Результат.ТекстСообщения = ОбработкаОшибки.ТекстСообщения;
		Если Не ОбработкаОшибки.ПисьмоОтправлено Тогда
			ВернутьВЧерновикиБезОшибок(Письмо, НомерПопытки);
			Результат.Итог = "ВозвращеноВЧерновики";
			Возврат Истина;
		КонецЕсли;
		Результат.Итог = "ОтправленоЧастично";
	КонецЕсли;

	Попытка
		Результат.ПисьмоУдалено = ЗаписатьРезультатОтправки(Письмо,
			РезультатОтправки.ИдентификаторПисьмаSMTP, РезультатОтправки.ИдентификаторПисьмаIMAP, ДатаОтправления);
	Исключение
		// Письмо ушло, но его дольше 2 минут держат открытым на редактирование. Пользователь видит
		// «Письмо отправлено»; регламентное задание может отправить письмо повторно (Ф2).
		ЗаписатьОшибку(Письмо, НомерПопытки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Истина;

КонецФункции

Процедура ВернутьВЧерновикиБезОшибок(Письмо, НомерПопытки)

	Попытка
		ВернутьВЧерновики(Письмо);
	Исключение
		ЗаписатьОшибку(Письмо, НомерПопытки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ОтправкаВыполняется(КлючЗадания)
	
	УстановитьПривилегированныйРежим(Истина);
	Отбор = Новый Структура("Ключ, Состояние", КлючЗадания, СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0;
	
КонецФункции

// Ошибка мгновенной отправки в журнал регистрации под типовым событием подсистемы почты (Ф2).
Процедура ЗаписатьОшибку(Письмо, НомерПопытки, ТекстОшибки)
	
	Комментарий = СтрШаблон(НСтр("ru = 'Мгновенная отправка, попытка %1: %2'", ОбщегоНазначения.КодОсновногоЯзыка()),
		НомерПопытки, ТекстОшибки);
	ЗаписьЖурналаРегистрации(УправлениеЭлектроннойПочтой.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Документы.ЭлектронноеПисьмоИсходящее, Письмо, Комментарий);
	
КонецПроцедуры

Функция НовыйРезультатОтправки(Письмо, УчетнаяЗапись)
	
	Результат = Новый Структура;
	Результат.Вставить("Итог", "");
	Результат.Вставить("ТекстСообщения", "");
	Результат.Вставить("Письмо", Письмо);
	Результат.Вставить("Тема", "");
	Результат.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	Результат.Вставить("ПисьмоУдалено", Ложь);
	Результат.Вставить("ПисьмоПринятоСервером", Ложь);
	Результат.Вставить("ОшибкаПодключения", Ложь);
	Возврат Результат;
	
КонецФункции

#КонецОбласти
