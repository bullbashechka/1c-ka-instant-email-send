#Область ПрограммныйИнтерфейс

// Успело ли письмо уйти. Вызывается клиентом, если фоновое задание отправки завершилось аварийно (Ф3).
//
// Параметры:
//  Письмо - ДокументСсылка.ЭлектронноеПисьмоИсходящее
//
// Возвращаемое значение:
//  Структура:
//   * Отправлено - Булево - письмо в статусе «Отправлено» или удалено.
//   * Удалено - Булево - письма нет в базе.
//
Функция СостояниеОтправки(Письмо) Экспорт

	Если Не ОбщегоНазначения.СсылкаСуществует(Письмо) Тогда
		Возврат Новый Структура("Отправлено, Удалено", Истина, Истина);
	КонецЕсли;

	Отправлено = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Письмо, "СтатусПисьма")
		= Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Отправлено;
	Возврат Новый Структура("Отправлено, Удалено", Отправлено, Ложь);

КонецФункции

#КонецОбласти
