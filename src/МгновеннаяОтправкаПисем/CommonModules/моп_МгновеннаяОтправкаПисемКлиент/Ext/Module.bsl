#Область ПрограммныйИнтерфейс

// Ждёт фоновую отправку без формы-владельца и окна ожидания и показывает результат (Ф1, Ф3).
//
// Параметры:
//  ДлительнаяОперация - см. ДлительныеОперации.ВыполнитьВФоне
//  ПараметрыПисьма - Структура - Письмо, Тема, УчетнаяЗапись.
//
Процедура ОжидатьРезультатОтправки(ДлительнаяОперация, ПараметрыПисьма) Экспорт

	ПараметрыПисьма.Вставить("АдресРезультата", ДлительнаяОперация.АдресРезультата);

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;

	Оповещение = Новый ОписаниеОповещения("ПослеОтправкиПисьма", моп_МгновеннаяОтправкаПисемКлиент, ПараметрыПисьма);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

// Обработчик завершения фоновой отправки.
//
// Параметры:
//  Результат - Структура, Неопределено - см. ДлительныеОперацииКлиент.ОжидатьЗавершение
//  ДополнительныеПараметры - Структура - Письмо, Тема, УчетнаяЗапись, АдресРезультата.
//
Процедура ПослеОтправкиПисьма(Результат, ДополнительныеПараметры) Экспорт

	РезультатОтправки = Неопределено;
	Если Результат <> Неопределено И Результат.Статус = "Выполнено" Тогда
		РезультатОтправки = ПолучитьИзВременногоХранилища(ДополнительныеПараметры.АдресРезультата);
	КонецЕсли;
	УдалитьИзВременногоХранилища(ДополнительныеПараметры.АдресРезультата);

	Если ТипЗнч(РезультатОтправки) <> Тип("Структура") Тогда
		РезультатОтправки = РезультатАварийногоЗавершения(Результат, ДополнительныеПараметры);
	КонецЕсли;

	ПоказатьРезультат(РезультатОтправки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Задание завершилось аварийно, не запустилось или отменено: письмо могло успеть уйти.
Функция РезультатАварийногоЗавершения(Результат, ПараметрыПисьма)

	РезультатОтправки = Новый Структура;
	РезультатОтправки.Вставить("Итог", "НеОтправлено");
	РезультатОтправки.Вставить("ТекстСообщения", "");
	РезультатОтправки.Вставить("Письмо", ПараметрыПисьма.Письмо);
	РезультатОтправки.Вставить("Тема", ПараметрыПисьма.Тема);
	РезультатОтправки.Вставить("УчетнаяЗапись", ПараметрыПисьма.УчетнаяЗапись);
	РезультатОтправки.Вставить("ПисьмоУдалено", Ложь);

	Если моп_МгновеннаяОтправкаПисемВызовСервера.ПисьмоОтправлено(ПараметрыПисьма.Письмо) Тогда
		РезультатОтправки.Итог = "Отправлено";
	ИначеЕсли Результат = Неопределено Тогда
		РезультатОтправки.ТекстСообщения = НСтр("ru = 'Отправка письма прервана'");
	Иначе
		РезультатОтправки.ТекстСообщения = Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;

	Возврат РезультатОтправки;

КонецФункции

// Уведомления по таблице Ф3.
Процедура ПоказатьРезультат(РезультатОтправки)

	Итог = РезультатОтправки.Итог;
	Если Итог = "Прекращено" Тогда
		Возврат;
	КонецЕсли;

	Письмо = РезультатОтправки.Письмо;
	Ссылка = ?(РезультатОтправки.ПисьмоУдалено, Неопределено, ПолучитьНавигационнуюСсылку(Письмо));

	Если Итог = "Отправлено" Или Итог = "ОтправленоЧастично" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Письмо отправлено'"), Ссылка, РезультатОтправки.Тема);
		Если Итог = "ОтправленоЧастично" Тогда
			ПоказатьПредупреждение(, РезультатОтправки.ТекстСообщения);
		КонецЕсли;

	ИначеЕсли Итог = "ВозвращеноВЧерновики" Тогда
		ОткрытьФорму("Документ.ЭлектронноеПисьмоИсходящее.ФормаОбъекта", Новый Структура("Ключ", Письмо));
		ПоказатьПредупреждение(, РезультатОтправки.ТекстСообщения);

	Иначе
		РаботаСПочтовымиСообщениямиКлиент.СообщитьОбОшибкеПодключения(РезультатОтправки.УчетнаяЗапись,
			НСтр("ru = 'Письмо не отправлено'"), РезультатОтправки.ТекстСообщения);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Письмо не отправлено'"), Ссылка, РезультатОтправки.Тема);
	КонецЕсли;

	Если Не РезультатОтправки.ПисьмоУдалено Тогда
		ОповеститьОбИзменении(Письмо);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
