#Область ПрограммныйИнтерфейс

// Тема письма со счётом на оплату (Ф10): «Счет на оплату № 123 от 20.10.2026».
// Несколько счетов перечисляются по дате, затем по номеру документа, одинаковые не повторяются:
// «Счет на оплату № 1 от 20.10.2026, № 2 от 21.10.2026».
// Номер печатается так же, как на печатной форме счёта: без префиксов организации и информационной базы
// и без ведущих нулей.
//
// Параметры:
//  ДанныеСчетов - Массив из Структура - счета:
//   * Номер - Строка - номер документа
//   * Дата - Дата - дата документа
//
// Возвращаемое значение:
//  Строка
//
Функция ТемаПисьмаСчетов(ДанныеСчетов) Экспорт

	Счета = Новый ТаблицаЗначений;
	Счета.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Счета.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Для Каждого ДанныеСчета Из ДанныеСчетов Цикл
		ЗаполнитьЗначенияСвойств(Счета.Добавить(), ДанныеСчета);
	КонецЦикла;
	Счета.Сортировать("Дата, Номер");

	Фрагменты = Новый Массив;
	Для Каждого СтрокаСчета Из Счета Цикл
		Фрагмент = СтрШаблон(НСтр("ru = '№ %1 от %2'"),
			ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(СтрокаСчета.Номер), Формат(СтрокаСчета.Дата, "ДЛФ=D"));
		Если Фрагменты.Найти(Фрагмент) = Неопределено Тогда
			Фрагменты.Добавить(Фрагмент);
		КонецЕсли;
	КонецЦикла;

	Возврат НСтр("ru = 'Счет на оплату'") + " " + СтрСоединить(Фрагменты, ", ");

КонецФункции

// Подставляет тему «Счет на оплату № … от …» в параметры письма с печатными формами счетов (Ф10).
// Объекты печати: «Счет на оплату клиенту» (форма любая) или «Заказ клиента» (только если все печатные формы письма
// помечены как форма счёта: типовая КА и обработка ГЕМ печатают счёт из заказа с номером и датой заказа).
// Тема не меняется, если объектов нет, среди них есть другие документы, у заказа формы не только счёта
// или данные документов не прочитаны.
// Ошибка формирования темы не прерывает создание письма: она пишется в журнал регистрации.
//
// Параметры:
//  ПараметрыОтправки - Структура - параметры письма, см. УправлениеПечатьюПереопределяемый.ПередОтправкойПоПочте
//   * Тема - Строка
//  ОбъектыПечати - Массив - объекты, по которым сформированы печатные формы
//  ПечатныеФормы - ТаблицаЗначений, Неопределено - печатные формы письма:
//   * Название - Строка
//   * ТабличныйДокумент - ТабличныйДокумент
//
Процедура ЗаполнитьТемуПисьма(ПараметрыОтправки, ОбъектыПечати, ПечатныеФормы = Неопределено) Экспорт

	Если ТипЗнч(ОбъектыПечати) <> Тип("Массив") Или ОбъектыПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЕстьЗаказ = Ложь;
	Для Каждого ОбъектПечати Из ОбъектыПечати Цикл
		Если ТипЗнч(ОбъектПечати) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			ЕстьЗаказ = Истина;
		ИначеЕсли ТипЗнч(ОбъектПечати) <> Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьЗаказ И Не ЭтоТолькоФормыСчета(ПечатныеФормы) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеСчетов = ДанныеДокументов(ОбъектыПечати);
		Если ДанныеСчетов <> Неопределено Тогда
			ПараметрыОтправки.Тема = ТемаПисьмаСчетов(ДанныеСчетов);
		КонецЕсли;
	Исключение
		Комментарий = СтрШаблон(НСтр("ru = 'Тема письма со счётом на оплату не подставлена: %1'",
			ОбщегоНазначения.КодОсновногоЯзыка()), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(УправлениеЭлектроннойПочтой.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение, Метаданные.Документы.СчетНаОплатуКлиенту, , Комментарий);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Метка, которой типовая КА и обработка ГЕМ помечают табличный документ печатной формы счёта на оплату.
//
// Возвращаемое значение:
//  Строка
//
Функция МеткаФормыСчета()

	Возврат "ПАРАМЕТРЫ_ПЕЧАТИ_СЧЕТНАОПЛАТУ";

КонецФункции

// Истина, если в письме есть печатные формы и все они помечены как форма счёта на оплату.
//
// Параметры:
//  ПечатныеФормы - ТаблицаЗначений, Неопределено
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоТолькоФормыСчета(ПечатныеФормы)

	Если ТипЗнч(ПечатныеФормы) <> Тип("ТаблицаЗначений") Или ПечатныеФормы.Количество() = 0
		Или ПечатныеФормы.Колонки.Найти("ТабличныйДокумент") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ПечатнаяФорма Из ПечатныеФормы Цикл
		Если ТипЗнч(ПечатнаяФорма.ТабличныйДокумент) <> Тип("ТабличныйДокумент")
			Или ВРег(ПечатнаяФорма.ТабличныйДокумент.ИмяПараметровПечати) <> МеткаФормыСчета() Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Номер и дата документов (счетов и заказов клиента). Документы, которые пользователь не может прочитать
// или которых нет в базе, не возвращаются.
//
// Параметры:
//  Документы - Массив из ДокументСсылка.СчетНаОплатуКлиенту, ДокументСсылка.ЗаказКлиента
//
// Возвращаемое значение:
//  Массив из Структура, Неопределено - Номер, Дата; Неопределено, если прочитаны не все документы
//
Функция ДанныеДокументов(Документы)

	УникальныеДокументы = Новый Массив;
	Для Каждого Документ Из Документы Цикл
		Если УникальныеДокументы.Найти(Документ) = Неопределено Тогда
			УникальныеДокументы.Добавить(Документ);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счета.Номер КАК Номер,
	|	Счета.Дата КАК Дата
	|ИЗ
	|	Документ.СчетНаОплатуКлиенту КАК Счета
	|ГДЕ
	|	Счета.Ссылка В(&Документы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Заказы.Номер,
	|	Заказы.Дата
	|ИЗ
	|	Документ.ЗаказКлиента КАК Заказы
	|ГДЕ
	|	Заказы.Ссылка В(&Документы)";
	Запрос.УстановитьПараметр("Документы", УникальныеДокументы);

	Данные = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные.Добавить(Новый Структура("Номер, Дата", Выборка.Номер, Выборка.Дата));
	КонецЦикла;

	Возврат ?(Данные.Количество() = УникальныеДокументы.Количество(), Данные, Неопределено);

КонецФункции

#КонецОбласти
