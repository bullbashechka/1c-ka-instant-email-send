#Область ПрограммныйИнтерфейс

// Правила доступности мгновенной отправки (Ф4, Ф5, Ф6). К базе не обращается.
// Одно правило для видимости «Отправить сейчас» в форме и для проверки при нажатии.
//
// Параметры:
//  СтатусПисьма - ПеречислениеСсылка.СтатусыИсходящегоЭлектронногоПисьма
//  ДатаКогдаОтправить - Дата - поле «Когда отправить».
//  ДатаАктуальностиОтправки - Дата - поле «Не отправлять после».
//  ПометкаУдаления - Булево - письмо помечено на удаление.
//  ВнешниеРесурсыЗаблокированы - Булево - работа с внешними ресурсами заблокирована БСП.
//  ТекущаяДата - Дата - текущая дата сеанса.
//
// Возвращаемое значение:
//  Структура:
//   * Доступна - Булево
//   * ТекстОтказа - Строка - причина для пользователя; пустая, если сообщать нечего.
//
Функция ДоступностьОтправки(СтатусПисьма, ДатаКогдаОтправить, ДатаАктуальностиОтправки, ПометкаУдаления,
	ВнешниеРесурсыЗаблокированы, ТекущаяДата) Экспорт
	
	Результат = Новый Структура("Доступна, ТекстОтказа", Ложь, "");
	Черновик = ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Черновик");
	
	Если ВнешниеРесурсыЗаблокированы Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Письмо не отправлено: работа с внешними ресурсами заблокирована'");
	ИначеЕсли ЗначениеЗаполнено(ДатаАктуальностиОтправки) И ДатаАктуальностиОтправки <= ТекущаяДата Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Письмо не отправлено: истёк срок, указанный в поле «Не отправлять после»'");
	ИначеЕсли ПометкаУдаления Тогда
		// Регламентное задание помеченные письма не отправляет.
	ИначеЕсли СтатусПисьма = Черновик И ЗначениеЗаполнено(ДатаКогдаОтправить) И ДатаКогдаОтправить >= ТекущаяДата Тогда
		// Обычная отложенная отправка: письмо отправит регламентное задание.
	ИначеЕсли СтатусПисьма = Черновик
		Или СтатусПисьма = ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Исходящее") Тогда
		Результат.Доступна = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
