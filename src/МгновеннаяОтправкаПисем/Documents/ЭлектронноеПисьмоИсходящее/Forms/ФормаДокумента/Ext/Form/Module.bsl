#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура моп_ДатаАктуальностиОтправкиПриИзменении(Элемент)

	// Кнопка «Отправить сейчас» сразу отражает новый срок (Ф4).
	УправлениеДоступностью();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
&После("ОпределитьВидимостьДоступностьЭлементовВЗависимостиОтСтатусаПисьма")
Процедура моп_ОпределитьВидимостьДоступностьЭлементовВЗависимостиОтСтатусаПисьма()

	// У существующего письма типовой ПриЧтенииНаСервере вызывает эту процедуру раньше ПриСозданииНаСервере.
	моп_РаботаСВнешнимиРесурсамиЗаблокирована = моп_МгновеннаяОтправкаПисем.ВнешниеРесурсыЗаблокированы();

	// Типовая КА отключает «Отправить сейчас» в клиент-серверной базе. Видимость и доступность задаёт клиент.
	Если Объект.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее Тогда
		Элементы.Отправить.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("УправлениеДоступностью")
Процедура моп_УправлениеДоступностью()

	Если Объект.СтатусПисьма <> ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Исходящее") Тогда
		Возврат;
	КонецЕсли;

	ПоказатьОтправитьСейчас = Не моп_РаботаСВнешнимиРесурсамиЗаблокирована
		И (Не ЗначениеЗаполнено(Объект.ДатаАктуальностиОтправки)
			Или Объект.ДатаАктуальностиОтправки > ОбщегоНазначенияКлиент.ДатаСеанса());

	Элементы.Отправить.Видимость = ПоказатьОтправитьСейчас;
	Элементы.Отправить.Доступность = ПоказатьОтправитьСейчас;
	Элементы.ФормаЗаписатьИЗакрыть.Видимость = Не ПоказатьОтправитьСейчас;

КонецПроцедуры

&НаСервере
&После("ПередЗаписьюНаСервере")
Процедура моп_ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, РежимЗаписи, РежимПроведения)

	// Черновик переходит в «Исходящие» уже скрытым от регламентного задания (Ф7).
	Если моп_МгновеннаяОтправка
		И ТекущийОбъект.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее Тогда
		ТекущийОбъект.ДатаКогдаОтправить =
			моп_МгновеннаяОтправкаПисем.ДатаСкрытияОтРегламентногоЗадания(ТекущаяДатаСеанса());
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ОтправитьПисьмоКлиент")
Процедура моп_ОтправитьПисьмоКлиент()

	Черновик = ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Черновик");
	Исходящее = ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Исходящее");
	БылоИсходящим = (Объект.СтатусПисьма = Исходящее);

	ДоступностьОтправки = моп_ПроверитьДоступностьОтправки(Объект.СтатусПисьма,
		Объект.ДатаКогдаОтправить, Объект.ДатаАктуальностиОтправки);

	Если Не ДоступностьОтправки.Доступна Тогда
		Если Объект.СтатусПисьма = Черновик Тогда
			// Как в типовой КА: письмо в «Исходящие», его отправит регламентное задание (Ф5, Ф6).
			ОтправлятьСообщенияСразу = Ложь;
			ПродолжитьВызов();
		ИначеЕсли БылоИсходящим Тогда
			// Без ПродолжитьВызов: иначе типовой код отправит письмо синхронно (Ф4).
			Элементы.Отправить.Видимость = Ложь;
			Элементы.ФормаЗаписатьИЗакрыть.Видимость = Истина;
			Если ЗначениеЗаполнено(ДоступностьОтправки.ТекстОтказа) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(ДоступностьОтправки.ТекстОтказа);
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Объект.СтатусПисьма = Черновик Тогда
		// Типовой ПередЗаписьюНаСервере переводит письмо в «Исходящие» и один раз добавляет текст исходного письма.
		ОтправлятьСообщенияСразу = Ложь;
		ВыполняетсяОтправка = Истина;
		моп_МгновеннаяОтправка = Истина;
		Записано = Записать();
		ВыполняетсяОтправка = Ложь;
		моп_МгновеннаяОтправка = Ложь;
		Если Не Записано Или Объект.СтатусПисьма <> Исходящее Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если Модифицированность Тогда
		Возврат;
	КонецЕсли;

	Запуск = моп_НачатьОтправку(Объект.Ссылка, Объект.УдалятьПослеОтправки, БылоИсходящим);
	Если Запуск.УжеОтправляется Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Письмо уже отправляется'"));
		Прочитать();
		Возврат;
	КонецЕсли;

	ПараметрыПисьма = Новый Структура("Письмо, Тема, УчетнаяЗапись", Объект.Ссылка, Объект.Тема, Объект.УчетнаяЗапись);
	// Закрыть до ожидания: если задание не запустилось или включён режим отладки БСП, результат приходит сразу,
	// и форма письма, открытая для «вернулось в черновики», иначе тут же закрылась бы.
	Закрыть();
	моп_МгновеннаяОтправкаПисемКлиент.ОжидатьРезультатОтправки(Запуск.ДлительнаяОперация, ПараметрыПисьма);

КонецПроцедуры

&НаСервереБезКонтекста
Функция моп_ПроверитьДоступностьОтправки(СтатусПисьма, ДатаКогдаОтправить, ДатаАктуальностиОтправки)

	Возврат моп_МгновеннаяОтправкаПисем.ПроверитьДоступностьОтправки(СтатусПисьма, ДатаКогдаОтправить, ДатаАктуальностиОтправки);

КонецФункции

&НаСервереБезКонтекста
Функция моп_НачатьОтправку(Письмо, УдалятьПослеОтправки, БылоИсходящим)

	Возврат моп_МгновеннаяОтправкаПисем.НачатьОтправку(Письмо, УдалятьПослеОтправки, БылоИсходящим);

КонецФункции

#КонецОбласти
