#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура моп_ДатаАктуальностиОтправкиПриИзменении(Элемент)

	// Кнопка «Отправить сейчас» сразу отражает новый срок (Ф4).
	УправлениеДоступностью();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
&После("ОпределитьВидимостьДоступностьЭлементовВЗависимостиОтСтатусаПисьма")
Процедура моп_ОпределитьВидимостьДоступностьЭлементовВЗависимостиОтСтатусаПисьма()

	// У существующего письма типовой ПриЧтенииНаСервере вызывает эту процедуру раньше ПриСозданииНаСервере.
	моп_РаботаСВнешнимиРесурсамиЗаблокирована = моп_МгновеннаяОтправкаПисем.ВнешниеРесурсыЗаблокированы();

	// Типовая КА отключает «Отправить сейчас» в клиент-серверной базе. Видимость и доступность задаёт клиент.
	Если Объект.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее Тогда
		Элементы.Отправить.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&После("УправлениеДоступностью")
Процедура моп_УправлениеДоступностью()

	Если Объект.СтатусПисьма <> ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Исходящее") Тогда
		Возврат;
	КонецЕсли;

	// У команды «Отправить» нет признака «Изменяет сохраняемые данные»: в форме «только просмотр» она доступна.
	ДоступностьОтправки = моп_МгновеннаяОтправкаПисемКлиентСервер.ДоступностьОтправки(Объект.СтатусПисьма,
		Объект.ДатаКогдаОтправить, Объект.ДатаАктуальностиОтправки, Объект.ПометкаУдаления,
		моп_РаботаСВнешнимиРесурсамиЗаблокирована, ОбщегоНазначенияКлиент.ДатаСеанса());
	ПоказатьОтправитьСейчас = ДоступностьОтправки.Доступна И Не ТолькоПросмотр;

	Элементы.Отправить.Видимость = ПоказатьОтправитьСейчас;
	Элементы.Отправить.Доступность = ПоказатьОтправитьСейчас;
	Элементы.ФормаЗаписатьИЗакрыть.Видимость = Не ПоказатьОтправитьСейчас;

КонецПроцедуры

&НаСервере
&После("ПередЗаписьюНаСервере")
Процедура моп_ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, РежимЗаписи, РежимПроведения)

	// Черновик переходит в «Исходящие» уже скрытым от регламентного задания (Ф7).
	Если моп_МгновеннаяОтправка
		И ТекущийОбъект.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее Тогда
		ТекущийОбъект.ДатаКогдаОтправить =
			моп_МгновеннаяОтправкаПисем.ДатаСкрытияОтРегламентногоЗадания(ТекущаяДатаСеанса());
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
&Вместо("ОтправитьПисьмоКлиент")
Процедура моп_ОтправитьПисьмоКлиент()

	Черновик = ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Черновик");
	БылоИсходящим = (Объект.СтатусПисьма = ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Исходящее"));

	Проверка = моп_ПроверкаПередОтправкой(Объект.Ссылка, БылоИсходящим, Объект.СтатусПисьма,
		Объект.ДатаКогдаОтправить, Объект.ДатаАктуальностиОтправки, Объект.ПометкаУдаления);

	// Письмо изменилось в базе, пока форма была открыта (Ф4). Модифицированную форму не сверяем:
	// её запись сама откажет типовым сообщением о конфликте версий.
	Если БылоИсходящим И Не Модифицированность И Проверка.Сверка = "Отправлено" Тогда
		// Поля формы устарели, отказ по ним не нужен: фоновая отправка сообщит «Письмо отправлено» (Ф7).
		моп_ОтправитьМгновенно(БылоИсходящим);
		Возврат;
	ИначеЕсли БылоИсходящим И Не Модифицированность И Проверка.Сверка <> "Отправлять" Тогда
		Письмо = Объект.Ссылка;
		Закрыть();
		Если Проверка.Сверка = "Переоткрыть" Тогда
			// Не Прочитать(): типовая форма при смене статуса на «Черновик» не возвращает скрытые для «Исходящего» элементы.
			ОткрытьФорму("Документ.ЭлектронноеПисьмоИсходящее.ФормаОбъекта", Новый Структура("Ключ", Письмо));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ДоступностьОтправки = Проверка.ДоступностьОтправки;
	Если Не ДоступностьОтправки.Доступна Тогда
		Если Объект.СтатусПисьма = Черновик Тогда
			// Как в типовой КА: письмо в «Исходящие», его отправит регламентное задание (Ф5, Ф6).
			ОтправлятьСообщенияСразу = Ложь;
			ПродолжитьВызов();
		ИначеЕсли БылоИсходящим Тогда
			// Без ПродолжитьВызов: иначе типовой код отправит письмо синхронно (Ф4).
			Элементы.Отправить.Видимость = Ложь;
			Элементы.ФормаЗаписатьИЗакрыть.Видимость = Истина;
			Если ЗначениеЗаполнено(ДоступностьОтправки.ТекстОтказа) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(ДоступностьОтправки.ТекстОтказа);
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Объект.СтатусПисьма = Черновик Тогда
		// Типовой ПередЗаписью помещает правленые вложения асинхронно, уже после запуска отправки (Ф1).
		Файлы = Новый Массив;
		Для Каждого Вложение Из Вложения Цикл
			Если Вложение.Расположение = 0 И Вложение.Редактируется Тогда
				Файлы.Добавить(Вложение.Ссылка);
			КонецЕсли;
		КонецЦикла;
		РедактируемыеВложения = Новый Массив;
		Если Файлы.Количество() > 0 Тогда
			// Правку в базу помещает только тот, кто занял файл; файл, не занятый пользователем, помещать нечего.
			// Файл, которого нет в рабочем каталоге (нет по пути в каталоге и пустое ПолноеИмяФайлаВРабочемКаталоге),
			// БСП освобождает без оповещения: это нажатие письмо не отправит, повторное «Отправить» отправит.
			// На сервере это не проверить: наличие файла видно только на клиенте.
			ЗанятыеФайлы = моп_ЗанятыеПользователемФайлы(Файлы);
			Для Каждого Вложение Из Вложения Цикл
				Если Вложение.Расположение <> 0 Или Не Вложение.Редактируется Тогда
					Продолжить;
				ИначеЕсли ЗанятыеФайлы.Найти(Вложение.Ссылка) = Неопределено Тогда
					Вложение.Редактируется = Ложь;
				Иначе
					РедактируемыеВложения.Добавить(Вложение.Ссылка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если РедактируемыеВложения.Количество() > 0 Тогда
			// Кнопку не выключаем: БСП может не вызвать оповещение, например при отказе в разрешении на работу с файлами.
			Контекст = Новый Структура("Вложения, Индекс, БылоИсходящим", РедактируемыеВложения, 0, БылоИсходящим);
			моп_ПоместитьВложение(Контекст);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	моп_ОтправитьМгновенно(БылоИсходящим);

КонецПроцедуры

&НаКлиенте
Процедура моп_ПоместитьВложение(Контекст)

	РаботаСФайламиКлиент.ПоместитьПрисоединенныйФайл(
		Новый ОписаниеОповещения("моп_ПослеПомещенияВложения", ЭтотОбъект, Контекст),
		Контекст.Вложения[Контекст.Индекс], УникальныйИдентификатор);

КонецПроцедуры

// Продолжение моп_ОтправитьПисьмоКлиент после помещения вложения в базу.
//
// Параметры:
//  Результат - Структура, Неопределено - ОписаниеОшибки, см. РаботаСФайламиКлиент.ПоместитьПрисоединенныйФайл
//  Контекст - Структура - Вложения (Массив из ссылок на файлы), Индекс, БылоИсходящим.
//
&НаКлиенте
Процедура моп_ПослеПомещенияВложения(Результат, Контекст) Экспорт

	// Письмо уже отправила другая цепочка помещения, запущенная повторным нажатием «Отправить», и закрыла форму.
	Если Не Открыта() Тогда
		Возврат;
	КонецЕсли;

	// Запись формы за время помещения перезаполнила вложения и сняла Редактируется, или файл уже поместила
	// другая цепочка: отправку продолжает она или следующее нажатие «Отправить».
	Строки = Вложения.НайтиСтроки(Новый Структура("Ссылка, Редактируется", Контекст.Вложения[Контекст.Индекс], Истина));
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("ОписаниеОшибки")
		И ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ОписаниеОшибки);
		Возврат;
	КонецЕсли;

	// Типовой ПередЗаписью не будет помещать файл повторно.
	Строки[0].Редактируется = Ложь;
	Контекст.Индекс = Контекст.Индекс + 1;
	Если Контекст.Индекс < Контекст.Вложения.Количество() Тогда
		моп_ПоместитьВложение(Контекст);
		Возврат;
	КонецЕсли;

	моп_ОтправитьМгновенно(Контекст.БылоИсходящим);

КонецПроцедуры

// Записывает письмо, запускает фоновую отправку и закрывает форму (Ф1, Ф4).
&НаКлиенте
Процедура моп_ОтправитьМгновенно(БылоИсходящим)

	Если Объект.СтатусПисьма = ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Черновик") Тогда
		// Типовой ПередЗаписьюНаСервере переводит письмо в «Исходящие» и один раз добавляет текст исходного письма.
		ОтправлятьСообщенияСразу = Ложь;
		ВыполняетсяОтправка = Истина;
		моп_МгновеннаяОтправка = Истина;
		Попытка
			Записано = Записать();
		Исключение
			// Иначе следующее обычное «Записать» переведёт черновик в «Исходящие».
			ВыполняетсяОтправка = Ложь;
			моп_МгновеннаяОтправка = Ложь;
			ВызватьИсключение;
		КонецПопытки;
		ВыполняетсяОтправка = Ложь;
		моп_МгновеннаяОтправка = Ложь;
		Если Не Записано
			Или Объект.СтатусПисьма <> ПредопределенноеЗначение("Перечисление.СтатусыИсходящегоЭлектронногоПисьма.Исходящее") Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если Модифицированность Тогда
		Возврат;
	КонецЕсли;

	Запуск = моп_НачатьОтправку(Объект.Ссылка, Объект.УдалятьПослеОтправки, БылоИсходящим, УникальныйИдентификатор);
	Если Запуск.УжеОтправляется Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Письмо уже отправляется'"));
		Прочитать();
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(Запуск.ТекстОтказа) Тогда
		// Причина временная (письмо редактирует другой пользователь): кнопка остаётся для повторной отправки (Ф4).
		ОбщегоНазначенияКлиент.СообщитьПользователю(Запуск.ТекстОтказа);
		Возврат;
	КонецЕсли;

	ДанныеПисьма = Новый Структура("Письмо, Тема, УчетнаяЗапись", Объект.Ссылка, Объект.Тема, Объект.УчетнаяЗапись);
	// Закрыть до ожидания: если задание не запустилось или включён режим отладки БСП, результат приходит сразу,
	// и форма письма, открытая для «вернулось в черновики», иначе тут же закрылась бы.
	Закрыть();
	моп_МгновеннаяОтправкаПисемКлиент.ОжидатьРезультатОтправки(Запуск.ДлительнаяОперация, ДанныеПисьма);

КонецПроцедуры

// Возвращаемое значение:
//  Структура:
//   * ДоступностьОтправки - см. моп_МгновеннаяОтправкаПисем.ПроверитьДоступностьОтправки
//   * Сверка - Строка - см. моп_МгновеннаяОтправкаПисем.СверкаПисьмаСБазой; для черновика и нового письма «Отправлять».
//
&НаСервереБезКонтекста
Функция моп_ПроверкаПередОтправкой(Письмо, БылоИсходящим, СтатусПисьма, ДатаКогдаОтправить, ДатаАктуальностиОтправки,
	ПометкаУдаления)

	Результат = Новый Структура("ДоступностьОтправки, Сверка");
	Результат.ДоступностьОтправки = моп_МгновеннаяОтправкаПисем.ПроверитьДоступностьОтправки(СтатусПисьма,
		ДатаКогдаОтправить, ДатаАктуальностиОтправки, ПометкаУдаления);
	Результат.Сверка = ?(БылоИсходящим И Не Письмо.Пустая(),
		моп_МгновеннаяОтправкаПисем.СверитьПисьмоСБазой(Письмо), "Отправлять");
	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//  Массив из ОпределяемыйТип.ПрисоединенныйФайл - файлы, занятые для редактирования текущим пользователем,
//   как РаботаСФайлами.ДанныеФайла().ФайлРедактируетТекущийПользователь.
//
&НаСервереБезКонтекста
Функция моп_ЗанятыеПользователемФайлы(Файлы)

	Редактирует = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Файлы, "Редактирует");
	Пользователь = Пользователи.АвторизованныйПользователь();
	Результат = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Если Редактирует[Файл] = Пользователь Тогда
			Результат.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция моп_НачатьОтправку(Письмо, УдалятьПослеОтправки, БылоИсходящим, ИдентификаторФормы)

	// Форма держит блокировку письма с первой правки до закрытия, и после записи тоже.
	// Иначе скрытие письма и фоновая отправка не смогли бы его записать.
	РазблокироватьДанныеДляРедактирования(Письмо, ИдентификаторФормы);
	Возврат моп_МгновеннаяОтправкаПисем.НачатьОтправку(Письмо, УдалятьПослеОтправки, БылоИсходящим);

КонецФункции

#КонецОбласти
